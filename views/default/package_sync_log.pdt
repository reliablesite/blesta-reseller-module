<?php
$this->Widget->clear();
$this->Widget->create("Reliablesite Package Sync Logs");
?>
<div class="inner">
    <div class="mb-2 row">
        <div class="col-6">
            <a class="btn btn-primary" href="<?php echo $vars['homeLink'] ?>">Back To Home</a>
        </div>
        <div class="col-6 text-right">
            <a class="btn btn-primary" href="<?php echo $vars['importPackageSettingLink'] ?>">Import Settings</a>
            <a class="btn btn-primary" href="<?php echo $vars['manualPackageSyncLink'] ?>">Manual Sync</a>
        </div>	
    </div>
    
    <div class="title_row first">
        <h3>Reliablesite Package Sync Logs</h3>
    </div>

    <table class="table table-border">
        <thead>
            <tr class="heading_row">
                <td>Date</td>
                <td>Log</td>
            </tr>
        </thead>
        <tbody>
            <?php
            foreach($logs as $log){
               ?>
                 <tr>
                    <td>
                        <?php echo $this->Html->safe(date('Y-m-d H:i:s',$log->date)); ?>
                    </td>
                    <td>
                        <input type="button" class="btn btn-default" value="Show Log" onclick="showLog(<?php echo $log->id ?>);" />
                    </td>
                </tr>
                <tr id="log-<?php echo $log->id ?>" style="display:none;">
                    <td colspan="2" class="subtable"><pre><?php echo $log->log ?></pre></td>
                </tr>
               <?php 
            }
            ?>    
        </tbody>
    </table>    

</div>
<?php
$this->Widget->end();
?>
<script type="text/javascript">
    
function showLog(id) {
    $('#log-' + id).toggle();
}
    
</script>   
