<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-check-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($notice) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-x-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($error) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
if (!empty($pending) && empty($server_options)) {
    echo '<div class="alert alert-warning d-flex align-items-center" role="alert">'
        . '<i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">No unassigned servers were found in your ReliableSite '
        . 'account. Add or free up a server before assigning.</p></div></div>';
}

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('Reliablesite.pending.box_title', true), ['id' => 'rs_pending_orders']);

if (empty($pending)) {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-hourglass-split" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0"><?php $this->_('Reliablesite.pending.none'); ?></p>
    </div>
<?php
} else {
?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Customer</th>
                    <th>Ordered</th>
                    <th><?php $this->_('Reliablesite.order.col_order'); ?></th>
                    <th>Assign Server</th>
                    <th class="text-end">Options</th>
                </tr>
            </thead>
            <tbody>
            <?php
            foreach ($pending as $svc) {
                $sid = (int) $svc->id;
                $state = $order_states[$sid] ?? null;
                $customer = trim(($svc->first_name ?? '') . ' ' . ($svc->last_name ?? ''));
                $svc_number = $svc->service_number ?? $svc->id;
            ?>
                <tr>
                    <td>#<?php echo $this->Html->safe($svc_number); ?></td>
                    <td>
                        <?php echo $this->Html->safe($customer); ?>
                        <div class="small text-muted"><?php echo $this->Html->safe($svc->email ?? ''); ?></div>
                    </td>
                    <td><?php echo $this->Html->safe($svc->date_added ?? ''); ?></td>
                    <td>
                        <?php
                        if ($state && !empty($state['placed'])) {
                            echo '<span class="rs-order-badge">' . $this->_('Reliablesite.order.placed_badge', true)
                                . ' #' . $this->Html->safe($state['order_id']);
                            if (!empty($state['invoice_id'])) {
                                echo '<small>' . $this->_('Reliablesite.order.invoice', true) . ' #'
                                    . $this->Html->safe($state['invoice_id']) . '</small>';
                            }
                            echo '</span>';
                        } else {
                            if ($state && ($state['status'] ?? '') === 'failed' && !empty($state['last_error'])) {
                                echo '<div class="rs-order-failed">' . $this->Html->safe($state['last_error']) . '</div>';
                            }
                            $btnLabel = ($state && ($state['status'] ?? '') === 'failed')
                                ? $this->_('Reliablesite.order.retry', true)
                                : $this->_('Reliablesite.order.create', true);
                        ?>
                            <button type="button" class="btn btn-sm btn-outline-secondary rs-order-btn"
                                data-service-id="<?php echo $this->Html->safe($sid); ?>"
                                data-service-number="<?php echo $this->Html->safe($svc_number); ?>"
                                data-customer="<?php echo $this->Html->safe($customer); ?>"><?php
                                    echo $this->Html->safe($btnLabel);
                                ?></button>
                        <?php
                        }
                        ?>
                    </td>
                    <td>
                        <form method="get">
                            <input type="hidden" name="scr" value="pendingorders" />
                            <input type="hidden" name="action" value="assign" />
                            <input type="hidden" name="service_id" value="<?php echo $this->Html->safe($svc->id); ?>" />
                            <input type="hidden" name="rs_server_label" value="" />
                            <div class="input-group input-group-sm" style="min-width:320px">
                                <select name="rs_server_id" class="form-select"
                                    onchange="this.form.rs_server_label.value=this.options[this.selectedIndex].getAttribute('data-label')||'';">
                                    <option value="">-- Select a server --</option>
                                    <?php foreach ($server_options as $srvid => $opt) { ?>
                                        <option value="<?php echo $this->Html->safe($srvid); ?>"
                                            data-label="<?php echo $this->Html->safe($opt['label']); ?>">
                                            <?php echo $this->Html->safe($opt['display']); ?>
                                        </option>
                                    <?php } ?>
                                </select>
                                <button type="submit" class="btn btn-primary">Assign</button>
                            </div>
                        </form>
                    </td>
                    <td class="text-end">
                        <form method="get" class="d-inline">
                            <input type="hidden" name="scr" value="pendingorders" />
                            <input type="hidden" name="action" value="cancel" />
                            <input type="hidden" name="service_id" value="<?php echo $this->Html->safe($svc->id); ?>" />
                            <button type="button" class="btn btn-sm btn-outline-danger rs-confirm"
                                title="Cancel service"
                                data-confirm-title="Cancel service"
                                data-confirm-button="Cancel service"
                                data-confirm-message="Cancel this service?"><i class="bi bi-x-lg"></i></button>
                        </form>
                    </td>
                </tr>
            <?php
            }
            ?>
            </tbody>
        </table>
    </div>

        <!-- Shared Create Order modal -->
        <div class="modal fade" id="rsOrderModal" tabindex="-1" aria-labelledby="rsOrderModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="get">
                        <div class="modal-header">
                            <h5 class="modal-title" id="rsOrderModalLabel"><?php $this->_('Reliablesite.order.modal_title'); ?></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="scr" value="pendingorders" />
                            <input type="hidden" name="action" value="order" />
                            <input type="hidden" name="service_id" id="rsOrderServiceId" value="" />

                            <p class="text-muted small" id="rsOrderProduct"></p>

                            <div class="mb-3">
                                <label for="rsOrderHostname" class="form-label"><?php $this->_('Reliablesite.order.hostname'); ?></label>
                                <input type="text" name="hostname" id="rsOrderHostname" class="form-control" required placeholder="server.example.com" />
                            </div>

                            <div class="mb-3">
                                <label for="rsOrderPayment" class="form-label"><?php $this->_('Reliablesite.order.payment_method'); ?></label>
                                <?php if (!empty($payment_methods)) { ?>
                                    <select name="payment_method" id="rsOrderPayment" class="form-select">
                                        <?php foreach ($payment_methods as $module => $label) { ?>
                                            <option value="<?php echo $this->Html->safe($module); ?>"><?php echo $this->Html->safe($label); ?></option>
                                        <?php } ?>
                                    </select>
                                <?php } else { ?>
                                    <input type="text" name="payment_method" id="rsOrderPayment" class="form-control" placeholder="paypal" />
                                    <span class="rs-help"><?php $this->_('Reliablesite.order.payment_method.fallback'); ?></span>
                                <?php } ?>
                            </div>

                            <div class="mb-3">
                                <label for="rsOrderPromo" class="form-label"><?php $this->_('Reliablesite.order.promo_code'); ?></label>
                                <input type="text" name="promo_code" id="rsOrderPromo" class="form-control" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_('Reliablesite.order.cancel_btn'); ?></button>
                            <button type="submit" class="btn btn-primary"><?php $this->_('Reliablesite.order.submit_btn'); ?></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script type="text/javascript">
        (function () {
            var el = document.getElementById('rsOrderModal');
            if (!el || typeof bootstrap === 'undefined') { return; }

            var modal = new bootstrap.Modal(el);

            document.querySelectorAll('.rs-order-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var num  = btn.getAttribute('data-service-number') || '';
                    var cust = btn.getAttribute('data-customer') || '';

                    el.querySelector('#rsOrderServiceId').value = btn.getAttribute('data-service-id') || '';
                    el.querySelector('#rsOrderProduct').textContent =
                        'Service #' + num + (cust ? ' \u2014 ' + cust : '');
                    el.querySelector('#rsOrderHostname').value = '';
                    el.querySelector('#rsOrderPromo').value = '';

                    modal.show();
                });
            });

            // Bootstrap manages focus, but only once the dialog is actually shown
            el.addEventListener('shown.bs.modal', function () {
                el.querySelector('#rsOrderHostname').focus();
            });
        })();
        </script>
<?php
}

$this->Widget->end();
