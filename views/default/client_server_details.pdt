<script type="text/javascript">
    jQuery(document).ready(function(){

       jQuery("form#rsRebootServer input#btnPowerOn, form#rsRebootServer input#btnPowerOff").click(function(e){
            
            e.preventDefault();

            var btn = jQuery(this);
            var btnName = btn.attr('name');
            var confirmMessage = "";
            var successMessage = "";
            var url = "";
            if(btnName == 'btnPowerOn'){
                confirmMessage = "<?php $this->_("Reliablesite.client_server_details.power_on_confirm_msg") ?>"
                url = "<?php echo $serverPowerOnLink ?>";
                successMessage = "<?php $this->_("Reliablesite.client_server_details.btn_power_on_success_msg") ?>"
            }
            else if(btnName == 'btnPowerOff'){
                confirmMessage = "<?php $this->_("Reliablesite.client_server_details.power_off_confirm_msg") ?>"
                url = "<?php echo $serverPowerOffLink ?>";
                successMessage = "<?php $this->_("Reliablesite.client_server_details.btn_power_off_success_msg") ?>"
            }

            swal({
                title:'Are you sure?',
                text: confirmMessage,
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
            .then((value) => {

                if (value) {
                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Processing...');

                     var data = jQuery("form#rsRebootServer").serialize();

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {
                        
                        if(result.success == 1){
                            swal({
                                title: "Success", 
                                text: successMessage, 
                                type: "success"
                            });
                        }
                        else if(result.errors){
                            swal(
                                'Error',
                                result.errors.join("\n"),
                                'error'
                            );
                        }
                        else{
                            alert("Something went wrong");
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                    });
                }

            });
            
        });

        jQuery("form#frmUpdateMAC input#btnUpdateMAC").click(function(e){

             e.preventDefault();

           
            swal({
                title:'Are you sure?',
                text: "Are you sure you want to update MAC?",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
            .then((value) => {

                if (value) {    
                    var btn = jQuery(this);

                    btn.attr('disabled',true);
                    btn.val('Updating...');


                    var url = jQuery("form#frmUpdateMAC").attr('action');
                    var data = jQuery("form#frmUpdateMAC").serialize();

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {

                        if(result.success == 1){
                            swal({
                                title: "Success", 
                                text: "MAC address updated successfully!", 
                                type: "success"
                            }).then(function() {
                                location.reload();
                            });

                        }
                        else if(result.errors){
                            swal({
                                title: "Error", 
                                text: result.errors.join("\n"),
                                type: "error"
                            }).then(function() {
                                location.reload();
                            });
                        }
                        else{
                            alert("Something went wrong");
                            location.reload();
                        }
                    })
                }
            })
        });

        jQuery("input[name='macAddrType']").change(function(e){
            if($(this).val() == 'custom'){
                $("#customMACBox").show();
            }
            else{
                $("#customMACBox").hide();
            }
        });
        
        /*Trigger change on page load*/
        $("select#serverIP").change();
    });

    function setIPAddressData(e){
        /*set reverse dns url id*/
        var ipAddressId  = $(e).find(":selected").attr('data-ipaddressid');
        var reverseDNSUrl =  "<?php echo $reverseDNSLink ?>&ipid="+ipAddressId;
        $("a#btnReverseDNS").attr('href', reverseDNSUrl);
    
        var customMAC  = $(e).find(":selected").attr('data-custommac');
        $("input#customMAC").val(customMAC);
        if(customMAC == ''){
            $("input#macAddrTypeServer").attr("checked", true).change();
        }
        else{
            $("input#macAddrTypeCustom").attr("checked", true).change();
        }
    }
</script>        

<?php
}
