<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-check-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($notice) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-x-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($error) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
foreach ((array) $errors as $e) {
    echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
}

$has_filter = ($search !== '');

ob_start();
?>
<div class="card-body border-top filter-section-body"<?php echo $has_filter ? '' : ' style="display: none;"'; ?>>
<form method="get" class="p-3 border rounded">
    <input type="hidden" name="scr" value="customers" />
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label for="rs_customers_search" class="form-label">Search</label>
            <input type="text" name="search" id="rs_customers_search" class="form-control"
                value="<?php echo $this->Html->safe($search); ?>" placeholder="Username or email" />
        </div>
    </div>
    <div class="d-flex gap-2 justify-content-end mt-3">
        <a href="?scr=customers" class="btn btn-secondary">Clear</a>
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>
</div>
<?php
$filter_html = ob_get_clean();

$this->Widget->clear();
if (!empty($section_tabs)) {
    $this->Widget->setTabs($section_tabs);
    $this->Widget->setNavStyle('nav-tabs-custom');
}
$this->Widget->setFilterHtml($filter_html, $has_filter);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('Reliablesite.customers.box_title', true), ['id' => 'rs_customers']);
?>
<div class="card-body border-bottom">
    <h6 class="form-section-header">Add Customer</h6>
    <?php
    // Dedicated POST to the edit-row endpoint (keeps the password out of the URL).
    $this->Form->create($add_action);
    ?>
    <input type="hidden" name="rs_action" value="add_customer" />
    <div class="row g-2 align-items-end">
        <div class="col-sm">
            <label for="rs_cust_username" class="form-label">Username</label>
            <input type="text" name="username" id="rs_cust_username" class="form-control" required />
        </div>
        <div class="col-sm">
            <label for="rs_cust_email" class="form-label">Email</label>
            <input type="email" name="email" id="rs_cust_email" class="form-control" required />
        </div>
        <div class="col-sm">
            <label for="rs_cust_password" class="form-label">Password</label>
            <input type="password" name="password" id="rs_cust_password" class="form-control" required />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add
            </button>
        </div>
    </div>
    <?php $this->Form->end(); ?>
    <div class="form-text mt-2">The result is shown on the module overview after saving.</div>
</div>

<?php
if (empty($customers)) {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-people" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No customers found.</p>
    </div>
<?php
} else {
?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Linked Client</th>
                    <th>Assigned Server(s)</th>
                </tr>
            </thead>
            <tbody>
            <?php
            foreach ($customers as $cust) {
                $email = $cust['emailAddress'] ?? ($cust['email'] ?? '');
                $username = $cust['userName'] ?? ($cust['username'] ?? '');
                $link = $linked[strtolower($email)] ?? null;
                $servers = $assigned_servers[strtolower($username)] ?? [];
            ?>
                <tr>
                    <td><?php echo $this->Html->safe($cust['userId'] ?? '-'); ?></td>
                    <td><?php echo $this->Html->safe($username); ?></td>
                    <td><?php echo $this->Html->safe($email); ?></td>
                    <td>
                        <?php
                        if ($link) {
                            echo '<a href="' . $this->Html->safe($client_base . $link['client_id'] . '/') . '">'
                                . $this->Html->safe($link['name']) . ' (#' . $this->Html->safe($link['id_code']) . ')</a>';
                        } else {
                            echo '<span class="text-muted">Not a local client</span>';
                        }
                        ?>
                    </td>
                    <td>
                        <?php
                        if (empty($servers)) {
                            echo '<span class="text-muted">None</span>';
                        } else {
                            foreach ($servers as $s) {
                                $lbl = $s['server_label'] !== '' ? $s['server_label'] : ('#' . $s['server_id']);
                                echo '<div class="rs-actions mb-1">';
                                echo '<span class="badge text-bg-info">' . $this->Html->safe($lbl) . '</span>';
                                echo '<a class="btn btn-sm btn-outline-danger rs-confirm" '
                                    . 'href="?scr=customers&amp;action=unassign&amp;rsid=' . urlencode($s['server_id']) . '" '
                                    . 'title="Unassign server" '
                                    . 'data-confirm-title="Unassign server" '
                                    . 'data-confirm-button="Unassign" '
                                    . 'data-confirm-message="Unassign this server? The service returns to Pending Orders.">'
                                    . '<i class="bi bi-x-lg"></i></a>';
                                echo '</div>';
                            }
                        }
                        ?>
                    </td>
                </tr>
            <?php
            }
            ?>
            </tbody>
        </table>
    </div>
<?php
}

$base = '?scr=customers&amp;search=' . urlencode($search) . '&amp;page=';

$this->Widget->footer();
?>
<nav aria-label="Customer pages">
    <ul class="pagination pagination-sm mb-0 justify-content-end">
        <li class="page-item<?php echo ($page > 1 ? '' : ' disabled'); ?>">
            <a class="page-link" href="<?php echo ($page > 1 ? $base . ($page - 1) : '#'); ?>">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page <?php echo (int) $page; ?></span></li>
        <li class="page-item<?php echo (empty($customers) ? ' disabled' : ''); ?>">
            <a class="page-link" href="<?php echo (empty($customers) ? '#' : $base . ($page + 1)); ?>">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
<?php
$this->Widget->end();
