                <div class="row">
                    <div class="col-md-12 form-group text-center">
                        <a href="<?php echo $manageServerLink ?>" class="btn btn-default"><?php $this->_('Reliablesite.back_to_manage_server') ?></a>
                    </div>
                </div>         
            </div>    
        </div>
        <?php
        $this->Form->end();
        ?>
        <script type="text/javascript">
            jQuery(document).ready(function(){

                jQuery("form#frmManageKVM input#btnEnableKVM, form#frmManageKVM input#btnDisableKVM").click(function(e){
            
                    e.preventDefault();

                    var btn = jQuery(this);
                    var btnName = btn.attr('name');
                    var successMessage = "";
                    var url = "";
                    if(btnName == 'btnEnableKVM'){
                        url = "<?php echo $enableKVMLink ?>";
                        successMessage = "<?php $this->_("Reliablesite.client_manage_kvm.btn_enable_kvm_success_msg") ?>"
                    }
                    else if(btnName == 'btnDisableKVM'){
                        url = "<?php echo $disableKVMLink ?>";
                        successMessage = "<?php $this->_("Reliablesite.client_manage_kvm.btn_disable_kvm_success_msg") ?>"
                    }

                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Processing...');

                    var data = jQuery("form#frmManageKVM").serialize();

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {
                        
                        if(result.success == 1){
                            swal({
                                title: "Success", 
                                text: successMessage, 
                                type: "success"
                            }).then(function() {
                                location.reload();
                            });
                        }
                        else if(result.errors){
                            swal({
                                title: "Error", 
                                text: result.errors.join("\n"),
                                type: "error"
                            }).then(function() {
                                location.reload();
                            });
                            
                        }
                        else{
                            alert("Something went wrong");
                            location.reload();
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                       

                    });
                    
                });
            });
        </script>

        <?php
}
?>            