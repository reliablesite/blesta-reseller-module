                            echo (isset($kvmDetails['kvM_IP']) ? $this->Html->safe($kvmDetails['kvM_IP']) : '-'); 
                            if(!empty($kvmDetails['kvM_IP'])){
                                ?>
                                <a href="https://<?php echo $kvmDetails['kvM_IP']; ?>" target="_blank" class="btn btn-primary btn-xs"><?php $this->_('Reliablesite.client_manage_kvm.btn_launch_kvm') ?> (https)</a>
                                <a href="http://<?php echo $kvmDetails['kvM_IP']; ?>" target="_blank" class="btn btn-primary btn-xs"><?php $this->_('Reliablesite.client_manage_kvm.btn_launch_kvm') ?> (http)</a>
