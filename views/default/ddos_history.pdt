<?php
foreach ((array) $errors as $e) {
    echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
}

$has_filter = ($search !== '');

ob_start();
?>
<div class="card-body border-top filter-section-body"<?php echo $has_filter ? '' : ' style="display: none;"'; ?>>
<form method="get" class="p-3 border rounded">
    <input type="hidden" name="scr" value="ddoshistory" />
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label for="rs_ddos_search" class="form-label">IP address</label>
            <input type="text" name="search" id="rs_ddos_search" class="form-control"
                value="<?php echo $this->Html->safe($search); ?>" placeholder="e.g. 203.0.113.10" />
        </div>
    </div>
    <div class="d-flex gap-2 justify-content-end mt-3">
        <a href="?scr=ddoshistory" class="btn btn-secondary">Clear</a>
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>
</div>
<?php
$filter_html = ob_get_clean();

$this->Widget->clear();
$this->Widget->setFilterHtml($filter_html, $has_filter);
$this->Widget->setBodyWrapper(false);
$this->Widget->create('DDoS History', ['id' => 'rs_ddos_history']);

if (empty($attacks)) {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-clock-history" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No attacks recorded.</p>
    </div>
<?php
} else {
?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>IP</th>
                    <th>Started</th>
                    <th>Ended</th>
                    <th>Peak</th>
                </tr>
            </thead>
            <tbody>
            <?php foreach ((array) $attacks as $atk) { ?>
                <tr>
                    <td class="rs-mono"><?php echo $this->Html->safe($atk['ipAddress'] ?? ($atk['ip'] ?? '')); ?></td>
                    <td><?php echo $this->Html->safe($atk['startTime'] ?? ''); ?></td>
                    <td><?php echo $this->Html->safe($atk['endTime'] ?? ''); ?></td>
                    <td><?php echo $this->Html->safe($atk['peak'] ?? ($atk['peakValue'] ?? '')); ?></td>
                </tr>
            <?php } ?>
            </tbody>
        </table>
    </div>
<?php
}

$base = '?scr=ddoshistory&amp;search=' . urlencode($search) . '&amp;page=';

$this->Widget->footer();
?>
<nav aria-label="DDoS history pages">
    <ul class="pagination pagination-sm mb-0 justify-content-end">
        <li class="page-item<?php echo ($page > 1 ? '' : ' disabled'); ?>">
            <a class="page-link" href="<?php echo ($page > 1 ? $base . ($page - 1) : '#'); ?>">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page <?php echo (int) $page; ?></span></li>
        <li class="page-item<?php echo (empty($attacks) ? ' disabled' : ''); ?>">
            <a class="page-link" href="<?php echo (empty($attacks) ? '#' : $base . ($page + 1)); ?>">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
<?php
$this->Widget->end();
