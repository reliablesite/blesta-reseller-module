<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Instant KVM</title>
<style>
html,body{width:100%;height:100%;margin:0;background:#0b1018;color:#edf2fa;font:16px/1.5 system-ui,sans-serif}
#instant-kvm{position:fixed;inset:0;width:100%;height:100vh;height:100dvh}
#kvm-status{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;background:#0b1018;overflow:auto}
#kvm-status[hidden]{display:none}
.kvm-notice{max-width:36rem;width:100%;padding:24px;box-sizing:border-box;background:#141e2c;border:1px solid #516177;border-radius:12px;overflow-wrap:anywhere}
h1{font-size:1.4rem;line-height:1.25;margin:0 0 12px}p{margin:0 0 16px}
#kvm-retry{min-height:44px;max-width:100%;white-space:normal;border:1px solid #96c8ff;border-radius:6px;background:#1969b8;color:#fff;padding:10px 16px;font:inherit;cursor:pointer}
#kvm-retry:focus-visible{outline:3px solid #c6e1ff;outline-offset:3px}
</style>
</head>
<body>
<div id="instant-kvm" aria-label="ReliableSite remote console"></div>
<div id="kvm-status" role="status" aria-live="polite">
    <div class="kvm-notice">
        <h1>Instant KVM</h1>
        <p id="kvm-message"><?php echo htmlspecialchars($console_error ?: 'Preparing your secure console…', ENT_QUOTES, 'UTF-8'); ?></p>
        <button id="kvm-retry" type="button"<?php echo $console_error ? '' : ' hidden'; ?>>Request a fresh launch</button>
        <noscript><p>JavaScript is required to open the console. You can close this tab to return to your server.</p></noscript>
    </div>
</div>
<script id="kvm-config" type="application/json"><?php echo json_encode($console_error ? null : $console_config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?></script>
<script><?php readfile(__DIR__ . '/js/rs-instant-kvm.js'); ?></script>
</body>
</html>
