<?php
$this->Widget->clear();
$this->Widget->create($this->_('Reliablesite.servers.box_title', true));
?>
<div class="inner">
    <div class="mb-2">
        <span>Pending orders awaiting assignment: <strong><?php echo (int) $pending_count; ?></strong></span>
    </div>
    <?php
    foreach ((array) $errors as $e) {
        echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
    }
    ?>
    <form method="get" class="mb-2">
        <input type="hidden" name="scr" value="servers" />
        <input type="text" name="search" value="<?php echo $this->Html->safe($search); ?>" class="form-control d-inline-block" placeholder="Search server id / name" style="width:220px" />
        <label class="inline"><input type="checkbox" name="unassigned" value="1" <?php echo ($unassigned === 'true' ? 'checked' : ''); ?> /> Unassigned only</label>
        <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
    </form>
    <table class="table">
        <thead>
        <tr>
            <th>Server ID</th>
            <th>Label</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th></th>
        </tr>
        </thead>
        <?php
        foreach ($servers as $srv) {
            $sid = isset($srv['serverId']) ? $srv['serverId'] : (isset($srv['id']) ? $srv['id'] : '');
            $status = isset($srv['status']) ? $srv['status'] : '';
            $statusCls = 'text-bg-secondary';
            switch (strtolower($status)) {
                case 'active':
                    $statusCls = 'text-bg-success';
                    break;
                case 'suspended':
                    $statusCls = 'text-bg-warning';
                    break;
                case 'cancelled':
                case 'terminated':
                    $statusCls = 'text-bg-danger';
                    break;
            }
            $link = isset($assigned[(string) $sid]) ? $assigned[(string) $sid] : null;
            ?>
            <tr>
                <td>#<?php echo $this->Html->safe($sid); ?></td>
                <td><?php echo $this->Html->safe(isset($srv['serverLabel']) ? $srv['serverLabel'] : (isset($srv['label']) ? $srv['label'] : '')); ?></td>
                <td><?php echo $status !== '' ? '<span class="badge ' . $statusCls . '">' . $this->Html->safe($status) . '</span>' : '-'; ?></td>
                <td>
                    <?php
                    if ($link) {
                        echo '<a href="' . $this->Html->safe($client_base . $link['client_id'] . '/') . '">'
                            . $this->Html->safe($link['name']) . '</a> '
                            . '<small class="text-muted">(service #' . $this->Html->safe($link['service_id']) . ')</small>';
                    } else {
                        echo '<span class="badge text-bg-success">Unassigned</span>';
                    }
                    ?>
                </td>
                <td><a class="btn btn-outline-secondary btn-sm" href="<?php echo $this->Html->safe($manage_base . '/?scr=manageserver&rsid=' . urlencode($sid)); ?>">Manage</a></td>
            </tr>
            <?php
        }
        if (empty($servers)) {
            echo '<tr><td colspan="5"><div class="text-center text-muted py-5"><i class="bi bi-hdd-rack" style="font-size:3rem;opacity:.3"></i><p class="mt-3 mb-0">No servers found.</p></div></td></tr>';
        }
        ?>
    </table>
    <div class="pagination_row">
        <?php if ($page > 1) { ?>
            <a class="btn btn-outline-secondary btn-sm" href="?scr=servers&amp;search=<?php echo urlencode($search); ?>&amp;unassigned=<?php echo ($unassigned === 'true' ? '1' : '0'); ?>&amp;page=<?php echo $page - 1; ?>">&laquo; Prev</a>
        <?php } ?>
        <a class="btn btn-outline-secondary btn-sm" href="?scr=servers&amp;search=<?php echo urlencode($search); ?>&amp;unassigned=<?php echo ($unassigned === 'true' ? '1' : '0'); ?>&amp;page=<?php echo $page + 1; ?>">Next &raquo;</a>
    </div>
</div>
<?php
$this->Widget->end();
