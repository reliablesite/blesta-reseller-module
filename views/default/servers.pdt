<?php
$this->Widget->clear();
$this->Widget->create($this->_('Reliablesite.servers.box_title', true));
?>
<div class="inner">
    <div class="mb-2">
        <span>Pending orders awaiting assignment: <strong><?php echo (int) $pending_count; ?></strong></span>
    </div>
    <?php
    foreach ((array) $errors as $e) {
        echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
    }
    ?>
    <form method="get" class="mb-2">
        <input type="hidden" name="scr" value="servers" />
        <input type="text" name="search" value="<?php echo $this->Html->safe($search); ?>" class="form-control" placeholder="Search server id / name" style="width:220px;display:inline-block;" />
        <label class="inline"><input type="checkbox" name="unassigned" value="1" <?php echo ($unassigned === 'true' ? 'checked' : ''); ?> /> Unassigned only</label>
        <button type="submit" class="btn btn-default btn-sm">Search</button>
    </form>
    <table class="table">
        <tr class="heading_row">
            <td>Server ID</td>
            <td>Label</td>
            <td>Status</td>
            <td>Assigned To</td>
            <td></td>
        </tr>
        <?php
        foreach ($servers as $srv) {
            $sid = isset($srv['serverId']) ? $srv['serverId'] : (isset($srv['id']) ? $srv['id'] : '');
            $status = isset($srv['status']) ? $srv['status'] : '';
            $statusCls = 'label-default';
            switch (strtolower($status)) {
                case 'active':
                    $statusCls = 'label-success';
                    break;
                case 'suspended':
                    $statusCls = 'label-warning';
                    break;
                case 'cancelled':
                case 'terminated':
                    $statusCls = 'label-danger';
                    break;
            }
            $link = isset($assigned[(string) $sid]) ? $assigned[(string) $sid] : null;
            ?>
            <tr>
                <td>#<?php echo $this->Html->safe($sid); ?></td>
                <td><?php echo $this->Html->safe(isset($srv['serverLabel']) ? $srv['serverLabel'] : (isset($srv['label']) ? $srv['label'] : '')); ?></td>
                <td><?php echo $status !== '' ? '<span class="label ' . $statusCls . '">' . $this->Html->safe($status) . '</span>' : '-'; ?></td>
                <td>
                    <?php
                    if ($link) {
                        echo '<a href="' . $this->Html->safe($client_base . $link['client_id'] . '/') . '">'
                            . $this->Html->safe($link['name']) . '</a> '
                            . '<small class="text-muted">(service #' . $this->Html->safe($link['service_id']) . ')</small>';
                    } else {
                        echo '<span class="label label-success">Unassigned</span>';
                    }
                    ?>
                </td>
                <td><a class="btn btn-default btn-sm" href="<?php echo $this->Html->safe($manage_base . '/?scr=manageserver&rsid=' . urlencode($sid)); ?>">Manage</a></td>
            </tr>
            <?php
        }
        if (empty($servers)) {
            echo '<tr><td colspan="5">No servers found.</td></tr>';
        }
        ?>
    </table>
    <div class="pagination_row">
        <?php if ($page > 1) { ?>
            <a class="btn btn-default btn-sm" href="?scr=servers&amp;search=<?php echo urlencode($search); ?>&amp;unassigned=<?php echo ($unassigned === 'true' ? '1' : '0'); ?>&amp;page=<?php echo $page - 1; ?>">&laquo; Prev</a>
        <?php } ?>
        <a class="btn btn-default btn-sm" href="?scr=servers&amp;search=<?php echo urlencode($search); ?>&amp;unassigned=<?php echo ($unassigned === 'true' ? '1' : '0'); ?>&amp;page=<?php echo $page + 1; ?>">Next &raquo;</a>
    </div>
</div>
<?php
$this->Widget->end();
