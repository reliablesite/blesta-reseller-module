<?php
if (!empty($flash) && !empty($flash['msg'])) {
    $cls = (isset($flash['type']) && $flash['type'] === 'success') ? 'alert-success' : 'alert-danger';
    echo '<div class="alert ' . $cls . '">' . $this->Html->safe($flash['msg']) . '</div>';
}

if (!empty($needs_credential)) {
    $this->Widget->clear();
    $this->Widget->create('ReliableSite');
    ?>
    <div class="inner">
        <div class="pad">
            <p>Welcome to the ReliableSite module. To get started, add your reseller API credentials.</p>
            <a class="btn btn-primary" href="<?php echo $this->Html->safe($add_link); ?>">Add API Credentials</a>
        </div>
    </div>
    <?php
    $this->Widget->end();
    return;
}

// Shared tab bar
echo $nav;

$this->Widget->clear();
$this->Widget->create('Overview' . ($account_name !== '' ? ' (' . $this->Html->safe($account_name) . ')' : ''), ['id' => 'manage_reliablesite']);
?>
<div class="inner">
    <div class="pad">
        <div style="display:flex;flex-wrap:wrap;gap:12px;">
            <a href="<?php echo $this->Html->safe($links['pending']); ?>" style="flex:1;min-width:170px;text-decoration:none;">
                <div class="rs-stat">
                    <div class="rs-stat-num" style="<?php echo ($stats['pending'] > 0 ? 'color:#d97706;' : ''); ?>"><?php echo (int) $stats['pending']; ?></div>
                    <div class="rs-stat-label"><i class="fas fa-hourglass-half"></i> Pending Orders</div>
                </div>
            </a>
            <a href="<?php echo $this->Html->safe($links['catalog']); ?>" style="flex:1;min-width:170px;text-decoration:none;">
                <div class="rs-stat">
                    <div class="rs-stat-num"><?php echo (int) $stats['tracked']; ?></div>
                    <div class="rs-stat-label"><i class="fas fa-box"></i> Tracked Products</div>
                </div>
            </a>
            <a href="<?php echo $this->Html->safe($links['catalog']); ?>" style="flex:1;min-width:170px;text-decoration:none;">
                <div class="rs-stat">
                    <div class="rs-stat-num" style="font-size:18px;color:#374151;margin-top:6px;"><?php echo $this->Html->safe($stats['last_sync']); ?></div>
                    <div class="rs-stat-label"><i class="fas fa-sync"></i> Last Catalog Sync</div>
                </div>
            </a>
        </div>
        <p style="margin-top:18px;" class="text-muted">Use the tabs above to manage pending orders, servers, the product catalog, customers, and DDoS protection.</p>
    </div>
</div>
<?php
$this->Widget->end();
