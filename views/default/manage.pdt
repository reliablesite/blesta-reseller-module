<?php
if (!empty($flash) && !empty($flash['msg'])) {
    $cls = (isset($flash['type']) && $flash['type'] === 'success') ? 'alert-success' : 'alert-danger';
    echo '<div class="alert ' . $cls . '">' . $this->Html->safe($flash['msg']) . '</div>';
}

if (!empty($needs_credential)) {
    $this->Widget->clear();
    $this->Widget->create('ReliableSite');
    ?>
    <div class="inner">
        <div class="pad">
            <p>Welcome to the ReliableSite module. To get started, add your reseller API credentials.</p>
            <a class="btn btn-primary" href="<?php echo $this->Html->safe($add_link); ?>">Add API Credentials</a>
        </div>
    </div>
    <?php
    $this->Widget->end();
    return;
}

// Shared tab bar
echo $nav;

$this->Widget->clear();
$this->Widget->create('Overview' . ($account_name !== '' ? ' (' . $this->Html->safe($account_name) . ')' : ''), ['id' => 'manage_reliablesite']);
?>
<div class="inner">
    <div class="pad">
        <div class="rs-stats">
            <a href="<?php echo $this->Html->safe($links['pending']); ?>" class="text-decoration-none">
                <div class="rs-stat">
                    <div class="rs-stat-num<?php echo ($stats['pending'] > 0 ? ' is-warning' : ''); ?>"><?php echo (int) $stats['pending']; ?></div>
                    <div class="rs-stat-label"><i class="bi bi-hourglass-split"></i> Pending Orders</div>
                </div>
            </a>
            <a href="<?php echo $this->Html->safe($links['catalog']); ?>" class="text-decoration-none">
                <div class="rs-stat">
                    <div class="rs-stat-num"><?php echo (int) $stats['tracked']; ?></div>
                    <div class="rs-stat-label"><i class="bi bi-box-seam"></i> Tracked Products</div>
                </div>
            </a>
            <a href="<?php echo $this->Html->safe($links['catalog']); ?>" class="text-decoration-none">
                <div class="rs-stat">
                    <div class="rs-stat-num is-text"><?php echo $this->Html->safe($stats['last_sync']); ?></div>
                    <div class="rs-stat-label"><i class="bi bi-arrow-repeat"></i> Last Catalog Sync</div>
                </div>
            </a>
        </div>
        <p class="text-muted mt-3">Use the tabs above to manage pending orders, servers, the product catalog, customers, and DDoS protection.</p>
    </div>
</div>
<?php
$this->Widget->end();
