<?php
$nav = ['overview' => 'Overview', 'os' => 'Reinstall OS', 'kvm' => 'KVM', 'bandwidth' => 'Bandwidth', 'backups' => 'Backups', 'rdns' => 'Reverse DNS', 'mac' => 'MAC', 'ddos' => 'DDoS'];
?>
<ul class="nav nav-pills mb-3">
    <?php foreach ($nav as $key => $label) {
        $active = ($page === $key) ? ' active' : ''; ?>
        <li class="nav-item"><a class="nav-link<?php echo $active; ?>" href="?p=<?php echo $key; ?>"><?php echo $label; ?></a></li>
    <?php } ?>
</ul>
<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success">' . $this->Html->safe($notice) . '</div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger">' . $this->Html->safe($error) . '</div>';
}
?>
<div class="card mb-3">
    <div class="card-header"><strong>MAC Address</strong></div>
    <div class="card-body">
        <?php $this->Form->create(); ?>
        <input type="hidden" name="action" value="set_mac" />
        <div class="form-group">
            <label>IP Address</label>
            <select name="ip" class="form-control">
                <?php foreach ((array) $ip_blocks as $blk) {
                    $desc = isset($blk['ipDescription']) ? $blk['ipDescription'] : ''; ?>
                    <option value="<?php echo $this->Html->safe($desc); ?>"><?php echo $this->Html->safe($desc); ?></option>
                <?php } ?>
            </select>
        </div>
        <div class="form-group">
            <div class="form-check">
                <input type="checkbox" name="custom_mac_enable" id="rs_custom_mac" value="1" class="form-check-input" />
                <label class="form-check-label" for="rs_custom_mac">Use a custom MAC address</label>
            </div>
        </div>
        <div class="form-group">
            <label>Custom MAC</label>
            <input type="text" name="custom_mac" class="form-control" placeholder="AA:BB:CC:DD:EE:FF" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Save MAC</button>
        <?php $this->Form->end(); ?>
    </div>
</div>
