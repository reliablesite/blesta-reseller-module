    <h6 class="form-section-header mt-4">Orders</h6>
    <div class="row g-3">
        <div class="col-md-6">
            <?php $label(
                'order_default_payment_method',
                $this->_('Reliablesite.row_meta.order_default_payment_method', true),
                $this->_('Reliablesite.row_meta.order_default_payment_method.note', true)
            ); ?>
            <?php
            $current_pm = $vars->order_default_payment_method ?? null;
            if (!empty($payment_methods)) {
                $pm_options = ['' => $this->_('Reliablesite.settings.payment_method_none', true)];
                foreach ($payment_methods as $pm_module => $pm_label) {
                    $pm_options[$pm_module] = $pm_label;
                }
                // Preserve a stored value that is no longer returned by the API.
                if ($current_pm !== null && $current_pm !== '' && !isset($pm_options[$current_pm])) {
                    $pm_options[$current_pm] = $current_pm;
                }
                $this->Form->fieldSelect('order_default_payment_method', $pm_options, $current_pm, [
                    'id' => 'order_default_payment_method', 'class' => 'form-select'
                ]);
            } else {
                $this->Form->fieldText('order_default_payment_method', $current_pm, [
                    'id' => 'order_default_payment_method',
                    'class' => 'form-control',
                    'placeholder' => 'paypal'
                ]);
            }
            ?>
        </div>
    </div>

