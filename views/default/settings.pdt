            <label for="sync_frequency" class="form-label">
                <?php $this->_('Reliablesite.row_meta.sync_frequency'); ?>
            </label>
            <?php $this->Form->fieldSelect(
                'sync_frequency',
                ['15' => '15', '30' => '30', '45' => '45', '60' => '60'],
