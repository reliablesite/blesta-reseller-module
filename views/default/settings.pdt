<?php
/**
 * Grouped by what an admin is actually deciding - how the module connects,
 * what it imports, what it does on a schedule, how orders are paid, and who
 * gets told - rather than by which API each setting happens to belong to.
 *
 * Explanatory text is a bi-info-circle tooltip beside the label, which is the
 * Paradigm idiom (see admin_company_billing_invoices_form.pdt) and keeps the
 * page short; a two-column grid does the rest.
 *
 * Checkboxes, not switches: Paradigm uses .form-check for saved form fields
 * (114 uses) and reserves .form-switch for live UI preferences (2 uses, both
 * immediate-effect toggles).
 */

// Form wraps the whole card, matching components/modules/cpanel/views/default/add_row.pdt.
// Opening it inside the card instead would leave </form> mis-nested in the footer.
$this->Form->create($form_action, ['class' => 'disable-on-submit']);

$this->Widget->clear();
$this->Widget->create($this->_('Reliablesite.settings.box_title', true), ['id' => 'rs_settings']);

/** Renders a Paradigm label, with the explanation as a tooltip rather than a line of help text. */
$label = function ($for, $text, $tip = null) {
    echo '<label for="' . $this->Html->safe($for) . '" class="form-label">' . $this->Html->safe($text);
    if ($tip !== null && $tip !== '') {
        echo '<i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"'
            . ' title="' . $this->Html->safe($tip) . '"></i>';
    }
    echo '</label>';
};

/**
 * A quieter heading for grouping inside one section. The assistant settings are
 * ten fields deep; without this they read as one undifferentiated block, and
 * promoting the groups to .form-section-header would make them look like peers
 * of Connection and Orders.
 */
$subsection = function ($text) {
    echo '<div class="rs-subsection">' . $this->Html->safe($text) . '</div>';
};
?>

    <h6 class="form-section-header">Connection</h6>
    <div class="row g-3">
        <div class="col-md-6">
            <?php $label(
                'account_name',
                $this->_('Reliablesite.row_meta.account_name', true),
                $edit ? 'The name this credential set is listed under. Fixed once saved.' : null
            ); ?>
            <?php if ($edit) { ?>
                <div class="input-group">
                    <input type="text" name="account_name" id="account_name" class="form-control"
                        value="<?php echo $this->Html->safe($vars->account_name ?? ''); ?>" readonly />
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                </div>
            <?php } else { ?>
                <input type="text" name="account_name" id="account_name" class="form-control"
                    value="<?php echo $this->Html->safe($vars->account_name ?? ''); ?>" required />
            <?php } ?>
        </div>

