                        </h4>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6 form-group text-center">
                        <?php
                            $this->Form->fieldSubmit("btnCancelInstallOS", $this->_('Reliablesite.client_manage_os.btn_cancel_install_os', true), array('id' => "btnCancelInstallOS", "class" => "btn btn-danger"));
                        ?>
                        <a href="" class="btn btn-default"><?php $this->_('Reliablesite.client_manage_os.btn_refresh_install_os') ?></a>
                    </div>
