                        ?>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label><?php $this->_("Reliablesite.client_manage_os.partitioning_scheme"); ?></label>
                        <?php
                        $this->Form->fieldSelect("partitioningSchemeId", ['' => $this->_("Reliablesite.select.please_select", true)], '', array('id' => "partitioningSchemeId", "class" => "form-control", "disabled" => "disabled"));
                        ?>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6 form-group text-center">
                        <?php
                            $this->Form->fieldSubmit("btnInstallOS", $this->_('Reliablesite.client_manage_os.btn_install_os', true), array('id' => "btnInstallOS", "class" => "btn btn-default"));
                        ?>
