        <div class="panel-pad">
            <div class="col-md-12">
                <h3><?php $this->_("Reliablesite.tab_ManageOS"); ?></h3>
                <div class="row">
                    <div class="col-md-6 service-info">
                        <label><?php $this->_("Reliablesite.client_server_details.server_name"); ?></label>
