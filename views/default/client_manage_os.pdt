        ?>
        <script type="text/javascript">
            jQuery(document).ready(function(){

                jQuery("form#frmCancelInstallOS").submit(function(e){
                    e.preventDefault();
                    jQuery('#rsError').html('');
                    var btn = jQuery("form#frmCancelInstallOS input#btnCancelInstallOS");

                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Cancelling...');


                    var url = jQuery(this).attr('action');
                    var data = jQuery(this).serialize();

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {
                        if(result.success == 1){

                            swal({
                                title: "Success", 
                                text: "Installation process cancelled successfully!", 
                                type: "success"
                            }
                            );

                            location.reload();

                        }
                        else if(result.errors){
                            swal(
                                'Error',
                                result.errors.join("\n"),
                                'error'
                            );
                        }
                        else{
                            alert("Something went wrong");
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                    });
                });
            });
        </script>

        <?php
    }
    else{
        $this->Form->create($installosLink, array('id'=> 'frmInstallOS'));
        $this->Form->fieldHidden("serverId", $rsServerId);
