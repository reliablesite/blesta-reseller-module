<script src="<?php echo $this->Html->safe($this->view_dir . 'js/sweetalert.min.js');?>"></script>
<script src="<?php echo $this->Html->safe($this->view_dir . 'js/select2.full.min.js');?>"></script>
<link rel="stylesheet" type="text/css" href="<?php echo $this->Html->safe($this->view_dir . '/css/select2.min.css');?>">
<?php
    $this->Widget->clear();
    $this->Widget->create('Manage Customer');
    ?>
    <div class="inner">
        <div class="mb-2">
            <a class="btn btn-primary" href="<?php echo $vars['homeLink'] ?>">Back To Home</a>
            <a class="btn btn-primary" href="<?php echo $vars['customerLink'] ?>">Back To Customers</a>
        </div>
        <?php 
        if(!empty($vars['errors']))
        {
            ?>
                <section class="error_section">
                    <article class="error_box error">
                        <a class="close" href="#">&times;</a>
                        <?php echo $vars['errors'][0];?>
                    </article>
                </section>
            <?php
        }
        else{

        
            ?>
            <div class="title_row first">
                <h3>Update Customer (ReliableSite)</h3>
            </div>
            <?php
                $this->Form->create($vars['updateCustomerLink'], array('id'=> 'rsUpdateCustomer'));
            ?>
            <div class="pad">
                <ul>
                    <li>
                        <?php
                        $this->Form->label("User Name", "username");                   
                        $this->Form->fieldText("username", (isset($vars['customer']['userName']) ? $vars['customer']['userName'] : null), array('id' => "username", "class" => "xlarge", "readonly" => "readonly"));
                        ?>
                    </li>
                    <li>
                        <?php
                        $this->Form->label("Email", "email");                   
                        $this->Form->fieldText("email", (isset($vars['customer']['emailAddress']) ? $vars['customer']['emailAddress'] : null), array('id' => "email", "class" => "xlarge"));
                        ?>
                    </li>
                    <li>
                        <?php
                        $this->Form->label("Password", "password");                   
                        $this->Form->fieldText("password", '', array('id' => "password", "class" => "xlarge"));
                        ?>
                    </li>
                    <li>
                        <?php
                        $this->Form->fieldSubmit("btnUpdateCusomer", 'Update Customer', array('id' => "btnUpdateCusomer", "class" => "btn btn-primary"));
                        ?>
                    </li>
                </ul>
            </div>    
       
            <?php
                $this->Form->end();
            ?>
            <div class="title_row first">
                <h3>Assign/Unassign Customer</h3>
            </div>
            <?php
                if($vars['isAssigned'] == true){
                    $this->Form->create($vars['unAssignCustomerLink'], array('id'=> 'unAssignCustomer'));
                }
                else{
                    $this->Form->create($vars['assignCustomerLink'], array('id'=> 'assignCustomer'));
                }
            ?>
            <div class="pad">
                <ul>
                    <li>
                        <?php
                        $this->Form->fieldHidden("rsUserId", $vars['rsUserId']);
                        $this->Form->label("ReliableSite User Name", "rsUserName");                   
                        $this->Form->fieldText("rsUserName", (isset($vars['customer']['userName']) ? $vars['customer']['userName'] : null), array('id' => "rsUserName", "class" => "xlarge", "readonly" => "readonly"));
                        ?>
                    </li>
                    <li>
                        <?php 
                        if($vars['isAssigned'] == true){
                            $this->Form->fieldHidden("clientId", $vars['assignedUser']->client_id);
                            $this->Form->label("Blesta Client", "username");                   
                            $this->Form->fieldText("username", (isset($vars['assignedUser']->first_name) ? $vars['assignedUser']->first_name.' '.$vars['assignedUser']->last_name.' ('.$vars['assignedUser']->email.')' : null), array('id' => "username", "class" => "xlarge", "readonly" => "readonly"));
                            ?>
                            <?php
                        }
                        else{
                        ?>
                       
                            <?php
                            $this->Form->label("Blesta Client(s)", "clientId");                   
                            $this->Form->fieldSelect("clientId", $vars['blestaClients'], '', array('id' => "clientId", "class" => "xlarge", "style" => "width:500px"));
                            ?>
                            <script>
                                jQuery(document).ready(function(){
                                    jQuery('select[name="clientId"]').select2();
                                })
                            </script>
                        
                        <?php
                        }
                        ?>    
                    </li>
                    <li>
                        <?php
                        if($vars['isAssigned'] == true){
                            $this->Form->fieldSubmit("btnUnAssignCustomer", 'Unassign Customer', array('id' => "btnUnAssignCustomer", "class" => "btn btn-primary"));
                        }
                        else{
                            $this->Form->fieldSubmit("btnAssignCustomer", 'Assign Customer', array('id' => "btnAssignCustomer", "class" => "btn btn-primary"));
                        }
                        
                        ?>
                    </li>
                </ul>
            </div>    
       
            <?php
                $this->Form->end();     
        }
        ?>
        </div>
    <?php
    $this->Widget->end();
    ?>
    <script type="text/javascript">
        jQuery(document).ready(function(){
            jQuery("form#rsUpdateCustomer").submit(function(e){
                e.preventDefault();
                
                var btn = jQuery("form#rsUpdateCustomer input#btnUpdateCusomer");

                btn.attr('disabled',true);
                var oldBtnHtml = btn.val();

                btn.val('Updating...');


                var url = jQuery(this).attr('action');
                var data = jQuery(this).serialize();

                $.ajax({
                    url : url,
                    method : "post",
                    data : data
                }).done(function (result) {
                    if(result.success == 1){
                        swal({
                                title: "Success", 
                                text: "Customer updated successfully!", 
                                type: "success"
                            }
                        );
                        
                    }
                    else{
                        swal(
                            'Error',
                            result.errors.join("\n"),
                            'error'
                        );
                    }

                    btn.val(oldBtnHtml);
                    btn.attr('disabled',false);

                });
            });

            jQuery("form#assignCustomer input#btnAssignCustomer").click(function(e){
                e.preventDefault();

                var btn = jQuery(this);

                btn.attr('disabled',true);
                var oldBtnHtml = btn.val();

                btn.val('Assigning...');


                var url = jQuery("form#assignCustomer").attr('action');
                var data = jQuery("form#assignCustomer").serialize();

                $.ajax({
                    url : url,
                    method : "post",
                    data : data
                }).done(function (result) {
                    if(result.success == 1){
                        swal({
                                title: "Success", 
                                text: "Customer Linked successfully!",
                                type: "success"
                            })
                            .then((value) => {
                                location.reload();
                            });
                    }
                    else{
                        swal(
                            'Error',
                            result.errors.join("\n"),
                            'error'
                        );
                    }

                    btn.val(oldBtnHtml);
                    btn.attr('disabled',false);

                });
            });

            jQuery("form#unAssignCustomer input#btnUnAssignCustomer").click(function(e){
                e.preventDefault();

                swal({
                    title:'Are you sure?',
                    text:"This will unassign client to Reliablesite User",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                .then((value) => {
                    if (value) {
                        var btn = jQuery(this);

                        btn.attr('disabled',true);
                        var oldBtnHtml = btn.val();

                        btn.val('Unassigning...');


                        var url = jQuery("form#unAssignCustomer").attr('action');
                        var data = jQuery("form#unAssignCustomer").serialize();

                        $.ajax({
                            url : url,
                            method : "post",
                            data : data
                        }).done(function (result) {
                            if(result.success == 1){
                                swal({
                                        title: "Success", 
                                        text: "Customer Unassigned successfully!",
                                        type: "success"
                                    }).then((value) => {
                                        location.reload();
                                    });
                            }
                            else{
                                swal(
                                    'Error',
                                    result.errors.join("\n"),
                                    'error'
                                );
                            }

                            btn.val(oldBtnHtml);
                            btn.attr('disabled',false);

                        });
                    }
                });

                
            });
        });
    </script>    