            ?>
            <?php if (!empty($profileList) && !empty($blocks)) { ?>
                <h6 class="form-section-header">Assign IP to profile</h6>
                <form method="get">
                    <?php echo $hidden; ?>
                    <input type="hidden" name="p" value="ddos" />
                    <input type="hidden" name="action" value="ddos_assign" />
