            </form>
            <?php
        // ===================== KVM =====================
        } elseif ($page === 'kvm') {
            include __DIR__ . '/instant_kvm_link.pdt';
            $enabled = !empty($kvm['accessEnabled']);
            $kget = function ($keys) use ($kvm) {
                foreach ((array) $keys as $k) {
                    if (isset($kvm[$k]) && $kvm[$k] !== '') {
                        return $kvm[$k];
                    }
                }
                return '';
            };
            if ($enabled) { ?>
                <p class="mb-3">KVM is <span class="badge text-bg-success">enabled</span>.</p>
                <table class="table table-sm">
                    <tbody>
                        <tr><th class="text-muted fw-normal" style="width:30%">Host</th><td class="rs-mono"><?php echo $this->Html->safe($kget(['ipAddress', 'ip', 'host'])); ?></td></tr>
                        <tr><th class="text-muted fw-normal">Username</th><td class="rs-mono"><?php echo $this->Html->safe($kget(['userName', 'user', 'username'])); ?></td></tr>
                        <tr><th class="text-muted fw-normal">Password</th><td class="rs-mono"><?php echo $this->Html->safe($kget(['password'])); ?></td></tr>
