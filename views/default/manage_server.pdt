                $en = !empty($acct['enabled']) || !empty($acct['enable']);
                ?>
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <strong><?php echo $this->Html->safe($user); ?></strong>
