<?php
$this->Widget->clear();
$this->Widget->create('Manage Server' . ($server_id !== '' ? ' #' . $this->Html->safe($server_id) : ''));
?>
<div class="inner">
    <div class="pad">
        <div class="mb-2">
            <a class="btn btn-default btn-sm" href="<?php echo $this->Html->safe($back_link); ?>">&laquo; Back to servers</a>
        </div>
        <?php
        if (!empty($notice)) {
            echo '<div class="alert alert-success">' . $this->Html->safe($notice) . '</div>';
        }
        if (!empty($error)) {
            echo '<div class="alert alert-danger">' . $this->Html->safe($error) . '</div>';
        }
        if ($server_id === '') {
            echo '<div class="alert alert-warning">No server selected.</div>';
            $this->Widget->end();
            return;
        }

        $sid = $this->Html->safe($server_id);
        $hidden = '<input type="hidden" name="scr" value="manageserver" /><input type="hidden" name="rsid" value="' . $sid . '" />';
        $tabs = ['overview' => 'Overview', 'os' => 'Reinstall OS', 'kvm' => 'KVM', 'bandwidth' => 'Bandwidth', 'backups' => 'Backups', 'rdns' => 'Reverse DNS', 'mac' => 'MAC', 'ddos' => 'DDoS'];
        ?>
        <ul class="nav nav-pills mb-3">
            <?php foreach ($tabs as $k => $lbl) {
                $a = ($page === $k) ? ' active' : ''; ?>
                <li class="nav-item"><a class="nav-link<?php echo $a; ?>" href="<?php echo $this->Html->safe($srv_base . 'p=' . $k); ?>"><?php echo $lbl; ?></a></li>
            <?php } ?>
        </ul>

        <?php
        // ===================== OVERVIEW =====================
        if ($page === 'overview') {
            $g = function ($k) use ($server) {
                return isset($server[$k]) ? $server[$k] : '';
            };
            $primaryIp = (!empty($ip_blocks) && isset($ip_blocks[0]['ipDescription'])) ? $ip_blocks[0]['ipDescription'] : '';
            $used = (float) $g('bandwidthUsed');
            $allowed = (float) $g('bandwidthAllowed');
            $pct = $allowed > 0 ? min(100, round($used / $allowed * 100)) : 0;
            ?>
            <div class="row">
                <div class="col-md-6">
                    <table class="table">
                        <tr><td>Label</td><td><?php echo $this->Html->safe($g('serverLabel')); ?></td></tr>
                        <tr><td>Status</td><td><?php echo $this->Html->safe($g('status')); ?></td></tr>
                        <tr><td>Datacenter</td><td><?php echo $this->Html->safe($g('dataCenterLabel')); ?></td></tr>
                        <tr><td>OS</td><td><?php echo $this->Html->safe($g('operatingSystem')); ?></td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table">
                        <tr><td>CPU</td><td><?php echo $this->Html->safe($g('cpuName')); ?></td></tr>
                        <tr><td>Memory</td><td><?php echo $this->Html->safe(trim($g('memorySize') . ' ' . $g('memoryType'))); ?></td></tr>
                        <tr><td>Primary IP</td><td><?php echo $this->Html->safe($primaryIp); ?></td></tr>
                        <tr><td>Server MAC</td><td><?php echo $this->Html->safe($g('serverMac')); ?></td></tr>
                    </table>
                </div>
            </div>
            <?php if ($allowed > 0) { ?>
                <p class="text-muted" style="margin:8px 0 4px;">Bandwidth: <?php echo $this->Html->safe($used); ?> / <?php echo $this->Html->safe($allowed); ?> GB (<?php echo $pct; ?>%)</p>
            <?php } ?>
            <div class="rs-actions" style="margin-top:10px;">
                <a class="btn btn-success btn-sm" href="<?php echo $this->Html->safe($srv_base . 'action=power_on&p=overview'); ?>">Power On</a>
                <a class="btn btn-danger btn-sm" href="<?php echo $this->Html->safe($srv_base . 'action=power_off&p=overview'); ?>" onclick="return confirm('Power off this server?');">Power Off</a>
                <a class="btn btn-default btn-sm" href="<?php echo $this->Html->safe($srv_base . 'action=unassign&p=overview'); ?>" onclick="return confirm('Unassign this server? The service returns to Pending Orders.');">Unassign</a>
            </div>
            <?php
        // ===================== OS REINSTALL =====================
        } elseif ($page === 'os') {
            $osList = [];
            foreach ((array) $compatible_os as $os) {
                if (is_array($os) && isset($os['operatingSystemId'])) {
                    $osList[] = $os;
                }
            }
            ?>
            <p class="text-danger">Reinstalling the OS erases all data on the server.</p>
            <form method="get">
                <?php echo $hidden; ?>
                <input type="hidden" name="p" value="os" />
                <input type="hidden" name="action" value="os_install" />
                <div class="form-group">
                    <label>Operating System</label>
                    <select name="os_id" class="form-control">
                        <?php foreach ($osList as $os) {
                            $oid = $os['operatingSystemId'];
                            $olabel = isset($os['osLabel']) ? $os['osLabel'] : $oid; ?>
                            <option value="<?php echo $this->Html->safe($oid); ?>"><?php echo $this->Html->safe($olabel); ?></option>
                        <?php } ?>
                    </select>
                </div>
                <div class="form-group"><label>Partitioning Scheme ID</label><input type="text" name="partitioning_scheme_id" class="form-control" /></div>
                <div class="form-group"><label>Server IP</label><input type="text" name="server_ip" class="form-control" /></div>
                <div class="form-group"><label>License Key (optional)</label><input type="text" name="license_key" class="form-control" /></div>
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reinstall the OS? All data will be erased.');">Start Reinstall</button>
            </form>
            <p style="margin-top:8px;"><a class="btn btn-default btn-sm" href="<?php echo $this->Html->safe($srv_base . 'action=os_cancel&p=os'); ?>">Cancel In-Progress Install</a></p>
            <?php
        // ===================== KVM =====================
        } elseif ($page === 'kvm') {
            $enabled = !empty($kvm['accessEnabled']);
            $kget = function ($keys) use ($kvm) {
                foreach ((array) $keys as $k) {
                    if (isset($kvm[$k]) && $kvm[$k] !== '') {
                        return $kvm[$k];
                    }
                }
                return '';
            };
            if ($enabled) { ?>
                <p>KVM is <span class="label label-success">enabled</span>.</p>
                <table class="table">
                    <tr><td>Host</td><td><?php echo $this->Html->safe($kget(['ipAddress', 'ip', 'host'])); ?></td></tr>
                    <tr><td>Username</td><td><?php echo $this->Html->safe($kget(['userName', 'user', 'username'])); ?></td></tr>
                    <tr><td>Password</td><td><?php echo $this->Html->safe($kget(['password'])); ?></td></tr>
                </table>
                <a class="btn btn-danger btn-sm" href="<?php echo $this->Html->safe($srv_base . 'action=disable_kvm&p=kvm'); ?>">Disable KVM</a>
            <?php } else { ?>
                <p>KVM is <span class="label label-default">disabled</span>.</p>
                <form method="get">
                    <?php echo $hidden; ?>
                    <input type="hidden" name="p" value="kvm" />
                    <input type="hidden" name="action" value="enable_kvm" />
                    <div class="form-group"><label>Allowed IP</label><input type="text" name="remote_ip" class="form-control" value="<?php echo $this->Html->safe($client_ip); ?>" /></div>
                    <button type="submit" class="btn btn-primary btn-sm">Enable KVM</button>
                </form>
            <?php }
        // ===================== BANDWIDTH =====================
        } elseif ($page === 'bandwidth') {
            $periods = ['Hour', 'Day', 'Week', 'Month', 'Year'];
            $hasData = !empty($bandwidth_series['labels']);
            ?>
            <div class="rs-actions mb-2">
                <?php foreach ($periods as $p) { ?>
                    <a class="btn btn-sm <?php echo ($period === $p ? 'btn-primary' : 'btn-default'); ?>" href="<?php echo $this->Html->safe($srv_base . 'p=bandwidth&period=' . $p); ?>"><?php echo $p; ?></a>
                <?php } ?>
            </div>
            <?php if (!$hasData) { ?>
                <p class="text-muted">No bandwidth data available for this period.</p>
            <?php } else { ?>
                <div style="position:relative;height:320px;width:100%;"><canvas id="rs-bw-chart-admin"></canvas></div>
                <script type="text/javascript">
                (function () {
                    var series = <?php echo json_encode($bandwidth_series); ?>;
                    function draw() {
                        if (typeof Chart === 'undefined') { setTimeout(draw, 200); return; }
                        var el = document.getElementById('rs-bw-chart-admin');
                        if (!el) { return; }
                        if (window.rsBwChartAdmin) { window.rsBwChartAdmin.destroy(); }
                        window.rsBwChartAdmin = new Chart(el, {
                            type: 'line',
                            data: { labels: series.labels, datasets: [
                                { label: 'In (Mbps)', data: series.in_mbps, borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,0.1)', fill: true, tension: 0.3, pointRadius: 0 },
                                { label: 'Out (Mbps)', data: series.out_mbps, borderColor: '#16a34a', backgroundColor: 'rgba(22,163,74,0.1)', fill: true, tension: 0.3, pointRadius: 0 }
                            ]},
                            options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, scales: { x: { ticks: { maxTicksLimit: 12, autoSkip: true } } } }
                        });
                    }
                    if (typeof Chart === 'undefined') {
                        var s = document.createElement('script');
                        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';
                        s.onload = draw; document.head.appendChild(s);
                    } else { draw(); }
                })();
                </script>
            <?php }
        // ===================== BACKUPS =====================
        } elseif ($page === 'backups') {
            if (empty($backups)) {
                echo '<p class="text-muted">No backup storage is provisioned for this server.</p>';
            }
            foreach ((array) $backups as $acct) {
                if (!is_array($acct)) {
                    continue;
                }
                $ftpId = isset($acct['ftpAccountId']) ? $acct['ftpAccountId'] : (isset($acct['id']) ? $acct['id'] : '');
                $user = isset($acct['username']) ? $acct['username'] : (isset($acct['ftpUsername']) ? $acct['ftpUsername'] : '');
                $en = !empty($acct['enabled']) || !empty($acct['enable']);
                ?>
                <div class="border rounded p-2 mb-2">
                    <p class="mb-1"><strong>Account:</strong> <?php echo $this->Html->safe($user); ?>
                        <?php echo $en ? '<span class="label label-success">Enabled</span>' : '<span class="label label-default">Disabled</span>'; ?></p>
                    <form method="get">
                        <?php echo $hidden; ?>
                        <input type="hidden" name="p" value="backups" />
                        <input type="hidden" name="action" value="set_backup" />
                        <input type="hidden" name="ftp_account_id" value="<?php echo $this->Html->safe($ftpId); ?>" />
                        <label class="inline"><input type="checkbox" name="enable" value="1" <?php echo $en ? 'checked' : ''; ?> /> Enabled</label>
                        <input type="password" name="password" class="form-control" placeholder="New FTP password" style="width:220px;display:inline-block;" />
                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    </form>
                </div>
                <?php
            }
        // ===================== REVERSE DNS =====================
        } elseif ($page === 'rdns') {
            ?>
            <form method="get">
                <?php echo $hidden; ?>
                <input type="hidden" name="p" value="rdns" />
                <input type="hidden" name="action" value="set_rdns" />
                <div class="form-group">
                    <label>IP Block</label>
                    <select name="ip_address_id" class="form-control">
                        <?php foreach ((array) $ip_blocks as $blk) {
                            $bid = isset($blk['ipAddressId']) ? $blk['ipAddressId'] : '';
                            $bdesc = isset($blk['ipDescription']) ? $blk['ipDescription'] : $bid; ?>
                            <option value="<?php echo $this->Html->safe($bid); ?>"><?php echo $this->Html->safe($bdesc); ?></option>
                        <?php } ?>
                    </select>
                </div>
                <div class="form-group"><label>IP Address</label><input type="text" name="ip_address" class="form-control" /></div>
                <div class="form-group"><label>Hostname (PTR)</label><input type="text" name="rdns" class="form-control" placeholder="host.example.com." /></div>
                <button type="submit" class="btn btn-primary btn-sm">Save rDNS</button>
            </form>
            <?php
        // ===================== MAC =====================
        } elseif ($page === 'mac') {
            ?>
            <form method="get">
                <?php echo $hidden; ?>
                <input type="hidden" name="p" value="mac" />
                <input type="hidden" name="action" value="set_mac" />
                <div class="form-group">
                    <label>IP Address</label>
                    <select name="ip" class="form-control">
                        <?php foreach ((array) $ip_blocks as $blk) {
                            $desc = isset($blk['ipDescription']) ? $blk['ipDescription'] : ''; ?>
                            <option value="<?php echo $this->Html->safe($desc); ?>"><?php echo $this->Html->safe($desc); ?></option>
                        <?php } ?>
                    </select>
                </div>
                <div class="form-group"><label class="inline"><input type="checkbox" name="custom_mac_enable" value="1" /> Use a custom MAC</label></div>
                <div class="form-group"><label>Custom MAC</label><input type="text" name="custom_mac" class="form-control" placeholder="AA:BB:CC:DD:EE:FF" /></div>
                <button type="submit" class="btn btn-primary btn-sm">Save MAC</button>
            </form>
            <?php
        // ===================== DDoS =====================
        } elseif ($page === 'ddos') {
            $profileList = isset($profiles) ? $profiles : [];
            $blocks = isset($server_blocks) ? $server_blocks : [];
            $prot = isset($protected) ? $protected : [];
            ?>
            <?php if (!empty($profileList) && !empty($blocks)) { ?>
                <h5>Assign IP to profile</h5>
                <form method="get">
                    <?php echo $hidden; ?>
                    <input type="hidden" name="p" value="ddos" />
                    <input type="hidden" name="action" value="ddos_assign" />
                    <input type="hidden" name="data_source_id" id="rs_a_ds" value="" />
                    <input type="hidden" name="profile_id" id="rs_a_pid" value="" />
                    <div class="form-group">
                        <label>Profile</label>
                        <select id="rs_a_profile" class="form-control"
                            onchange="var o=this.options[this.selectedIndex];document.getElementById('rs_a_ds').value=o.getAttribute('data-ds')||'';document.getElementById('rs_a_pid').value=o.getAttribute('data-pid')||'';">
                            <option value="">-- pick a profile --</option>
                            <?php foreach ($profileList as $p) {
                                $profile = isset($p['profile']) && is_array($p['profile']) ? $p['profile'] : [];
                                $pid = isset($profile['id']) ? $profile['id'] : (isset($p['profileId']) ? $p['profileId'] : '');
                                $pname = isset($profile['name']) ? $profile['name'] : (isset($p['name']) ? $p['name'] : '');
                                $dsId = isset($p['dataSourceId']) ? $p['dataSourceId'] : ''; ?>
                                <option value="<?php echo $this->Html->safe($dsId . ':' . $pid); ?>" data-ds="<?php echo $this->Html->safe($dsId); ?>" data-pid="<?php echo $this->Html->safe($pid); ?>"><?php echo $this->Html->safe($pname); ?></option>
                            <?php } ?>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Subnet</label>
                        <select class="form-control" onchange="document.getElementById('rs_a_ip').value=this.value;">
                            <?php $firstCidr = '';
                            foreach ($blocks as $b) {
                                $desc = isset($b['description']) ? $b['description'] : '';
                                if ($desc === '') { continue; }
                                if ($firstCidr === '') { $firstCidr = $desc; } ?>
                                <option value="<?php echo $this->Html->safe($desc); ?>"><?php echo $this->Html->safe($desc); ?></option>
                            <?php } ?>
                        </select>
                    </div>
                    <div class="form-group"><label>IP or CIDR</label><input type="text" name="ip_input" id="rs_a_ip" class="form-control" value="<?php echo $this->Html->safe($firstCidr); ?>" /></div>
                    <button type="submit" class="btn btn-primary btn-sm">Assign</button>
                </form>
            <?php } elseif (empty($profileList)) { ?>
                <div class="alert alert-info">No DDoS profiles are available for this server's datacenter.</div>
            <?php } ?>

            <h5 style="margin-top:14px;">Currently protected (<?php echo (int) count($prot); ?>)</h5>
            <?php if (empty($prot)) { ?>
                <p class="text-muted">No DDoS profile assignments for this server.</p>
            <?php } else { ?>
                <table class="table">
                    <tr class="heading_row"><td>Profile</td><td>IP</td><td></td></tr>
                    <?php foreach ($prot as $entry) { ?>
                        <tr>
                            <td><?php echo $this->Html->safe($entry['profile_name']); ?></td>
                            <td style="font-family:monospace;"><?php echo $this->Html->safe($entry['ip']); ?></td>
                            <td><a class="btn btn-danger btn-sm" href="<?php echo $this->Html->safe($srv_base . 'p=ddos&action=ddos_remove&data_source_id=' . urlencode($entry['data_source_id']) . '&profile_id=' . urlencode($entry['profile_id']) . '&ip_id=' . urlencode($entry['ip_id'])); ?>" onclick="return confirm('Remove this IP from the profile?');">Remove</a></td>
                        </tr>
                    <?php } ?>
                </table>
            <?php }
        }
        ?>
    </div>
</div>
<?php
$this->Widget->end();
