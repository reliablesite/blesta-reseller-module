<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-check-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($notice) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-x-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($error) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}

$link_buttons = [[
    'name' => 'Back to servers',
    'icon' => 'bi bi-arrow-left me-1',
    'attributes' => ['href' => $back_link],
]];

if ($server_id === '') {
    $this->Widget->clear();
    $this->Widget->setLinkButtons($link_buttons);
    $this->Widget->create('Manage Server', ['id' => 'rs_manage_server']);
    ?>
    <div class="text-center text-muted py-5">
        <i class="bi bi-hdd-rack" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No server selected.</p>
    </div>
    <?php
    $this->Widget->end();
    return;
}

$sid = $this->Html->safe($server_id);
$hidden = '<input type="hidden" name="scr" value="manageserver" /><input type="hidden" name="rsid" value="' . $sid . '" />';

$pages = [
    'overview'  => ['Overview', 'bi-info-circle'],
    'os'        => ['Reinstall OS', 'bi-disc'],
    'kvm'       => ['KVM', 'bi-display'],
    'bandwidth' => ['Bandwidth', 'bi-graph-up'],
    'backups'   => ['Backups', 'bi-archive'],
    'rdns'      => ['Reverse DNS', 'bi-signpost'],
    'mac'       => ['MAC', 'bi-ethernet'],
    'ddos'      => ['DDoS', 'bi-shield-check'],
];

$tabs = [];
foreach ($pages as $key => $meta) {
    $tabs[] = [
        'name' => '<i class="bi ' . $meta[1] . ' me-1"></i>' . $meta[0],
        'current' => ($page === $key),
        'attributes' => ['href' => $this->Html->safe($srv_base . 'p=' . $key)],
    ];
}

// These tabs are this server's own sub-pages, not module navigation - the
// module bar above stays a single row and marks Provisioning > Servers as
// current. "Back to servers" is the way up.
$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setTabs($tabs);
$this->Widget->setNavStyle('nav-tabs-custom');
$this->Widget->create(
    'Manage Server' . ($server_id !== '' ? ' #' . $server_id : ''),
    ['id' => 'rs_manage_server']
);
?>
        <?php
        // ===================== OVERVIEW =====================
        if ($page === 'overview') {
            $g = function ($k) use ($server) {
                return isset($server[$k]) ? $server[$k] : '';
            };
            $primaryIp = (!empty($ip_blocks) && isset($ip_blocks[0]['ipDescription'])) ? $ip_blocks[0]['ipDescription'] : '';
            $used = (float) $g('bandwidthUsed');
            $allowed = (float) $g('bandwidthAllowed');
            $pct = $allowed > 0 ? min(100, round($used / $allowed * 100)) : 0;
            ?>
            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="form-section-header">Server</h6>
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr><th class="text-muted fw-normal" style="width:40%">Label</th><td><?php echo $this->Html->safe($g('serverLabel')); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Status</th><td><?php echo $this->Html->safe($g('status')); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Datacenter</th><td><?php echo $this->Html->safe($g('dataCenterLabel')); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Operating system</th><td><?php echo $this->Html->safe($g('operatingSystem')); ?></td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <h6 class="form-section-header">Hardware</h6>
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr><th class="text-muted fw-normal" style="width:40%">CPU</th><td><?php echo $this->Html->safe($g('cpuName')); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Memory</th><td><?php echo $this->Html->safe(trim($g('memorySize') . ' ' . $g('memoryType'))); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Primary IP</th><td class="rs-mono"><?php echo $this->Html->safe($primaryIp); ?></td></tr>
                            <tr><th class="text-muted fw-normal">Server MAC</th><td class="rs-mono"><?php echo $this->Html->safe($g('serverMac')); ?></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <?php if ($allowed > 0) { ?>
                <h6 class="form-section-header mt-4">Bandwidth</h6>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span><?php echo $this->Html->safe($used); ?> GB of <?php echo $this->Html->safe($allowed); ?> GB used</span>
                    <span><?php echo $pct; ?>%</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Bandwidth used"
                    aria-valuenow="<?php echo $pct; ?>" aria-valuemin="0" aria-valuemax="100" style="height:8px">
                    <div class="progress-bar<?php echo ($pct >= 90 ? ' bg-danger' : ($pct >= 75 ? ' bg-warning' : '')); ?>"
                        style="width: <?php echo $pct; ?>%"></div>
                </div>
            <?php } ?>

            <h6 class="form-section-header mt-4">Power</h6>
            <div class="rs-actions">
                <a class="btn btn-sm btn-success" href="<?php echo $this->Html->safe($srv_base . 'action=power_on&p=overview'); ?>">
                    <i class="bi bi-play-fill me-1"></i>Power On
                </a>
                <a class="btn btn-sm btn-danger rs-confirm" href="<?php echo $this->Html->safe($srv_base . 'action=power_off&p=overview'); ?>"
                    data-confirm-title="Power off server" data-confirm-button="Power Off"
                    data-confirm-message="Power off this server?">
                    <i class="bi bi-power me-1"></i>Power Off
                </a>
                <a class="btn btn-sm btn-outline-danger rs-confirm ms-auto" href="<?php echo $this->Html->safe($srv_base . 'action=unassign&p=overview'); ?>"
                    data-confirm-title="Unassign server" data-confirm-button="Unassign"
                    data-confirm-message="Unassign this server? The service returns to Pending Orders.">
                    <i class="bi bi-x-lg me-1"></i>Unassign
                </a>
            </div>
            <?php
        // ===================== OS REINSTALL =====================
        } elseif ($page === 'os') {
            $osList = [];
