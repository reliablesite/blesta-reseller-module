<?php
$nav = ['overview' => 'Overview', 'os' => 'Reinstall OS', 'kvm' => 'KVM', 'bandwidth' => 'Bandwidth', 'backups' => 'Backups', 'rdns' => 'Reverse DNS', 'mac' => 'MAC', 'ddos' => 'DDoS'];
?>
<ul class="nav nav-pills mb-3">
    <?php foreach ($nav as $key => $label) {
        $active = ($page === $key) ? ' active' : ''; ?>
        <li class="nav-item"><a class="nav-link<?php echo $active; ?>" href="?p=<?php echo $key; ?>"><?php echo $label; ?></a></li>
    <?php } ?>
</ul>
<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success">' . $this->Html->safe($notice) . '</div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger">' . $this->Html->safe($error) . '</div>';
}
$osList = [];
foreach ((array) $compatible_os as $os) {
    if (is_array($os) && isset($os['operatingSystemId'])) {
        $osList[] = $os;
    }
}
$defaults = [];
foreach ($osList as $os) {
    $defaults[(string) $os['operatingSystemId']] = isset($os['defaultPartitioningSchemeId']) ? $os['defaultPartitioningSchemeId'] : '';
}
?>
<div class="card mb-3">
    <div class="card-header"><strong>Reinstall Operating System</strong></div>
    <div class="card-body">
        <p class="text-danger">Reinstalling the OS erases all data on the server. This cannot be undone.</p>
        <?php $this->Form->create(); ?>
        <input type="hidden" name="action" value="os_install" />
        <div class="form-group">
            <label>Operating System</label>
            <select name="os_id" id="rs_os_id" class="form-control">
                <?php foreach ($osList as $os) {
                    $oid = $os['operatingSystemId'];
                    $olabel = isset($os['osLabel']) ? $os['osLabel'] : $oid; ?>
                    <option value="<?php echo $this->Html->safe($oid); ?>"><?php echo $this->Html->safe($olabel); ?></option>
                <?php } ?>
            </select>
        </div>
        <div class="form-group">
            <label>Partitioning Scheme ID</label>
            <input type="text" name="partitioning_scheme_id" id="rs_scheme_id" class="form-control" />
        </div>
        <div class="form-group">
            <label>Server IP</label>
            <input type="text" name="server_ip" class="form-control" />
        </div>
        <div class="form-group">
            <label>License Key (Windows, optional)</label>
            <input type="text" name="license_key" class="form-control" />
        </div>
        <button type="submit" class="btn btn-danger" onclick="return confirm('Reinstall the OS? All data will be erased.');">Start Reinstall</button>
        <?php $this->Form->end(); ?>
        <?php $this->Form->create(); ?>
        <input type="hidden" name="action" value="os_cancel" />
        <button type="submit" class="btn btn-default mt-2">Cancel In-Progress Install</button>
        <?php $this->Form->end(); ?>
    </div>
</div>
<script type="text/javascript">
(function () {
    var defaults = <?php echo json_encode($defaults); ?>;
    var sel = document.getElementById('rs_os_id');
    var scheme = document.getElementById('rs_scheme_id');
    function sync() {
        if (sel && scheme && defaults[sel.value] !== undefined) {
            scheme.value = defaults[sel.value];
        }
    }
    if (sel) {
        sel.addEventListener('change', sync);
        sync();
    }
})();
</script>
