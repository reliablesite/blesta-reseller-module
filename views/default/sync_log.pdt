<?php
$this->Widget->clear();
$this->Widget->create('Catalog Sync Log', ['id' => 'rs_sync_log']);

if (empty($logs)) {
?>
    <div class="text-center text-muted py-5">
        <i class="bi bi-list-ul" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No sync runs recorded yet.</p>
    </div>
<?php
} else {
    $first = true;
    foreach ((array) $logs as $log) {
        $when = isset($log->date) ? date('Y-m-d H:i:s', (int) $log->date) : '';
?>
        <h6 class="form-section-header<?php echo $first ? '' : ' mt-4'; ?>">
            <i class="bi bi-clock-history me-1"></i><?php echo $this->Html->safe($when); ?>
        </h6>
        <pre class="rs-log mb-0"><?php echo $this->Html->safe($log->log ?? ''); ?></pre>
<?php
        $first = false;
    }
}

$this->Widget->end();
