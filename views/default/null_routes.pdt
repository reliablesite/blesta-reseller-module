<?php
if (!empty($notice)) {
    echo '<div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-check-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($notice) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}
if (!empty($error)) {
    echo '<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">'
        . '<i class="bi bi-x-circle-fill me-3 fs-5"></i>'
        . '<div class="flex-grow-1"><p class="m-0">' . $this->Html->safe($error) . '</p></div>'
        . '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
}

$this->Widget->clear();
$this->Widget->setLinkButtons($tool_buttons ?? []);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('Reliablesite.null_routes.box_title', true), ['id' => 'rs_null_routes']);
?>
<div class="card-body border-bottom">
    <h6 class="form-section-header">Add Null Route</h6>
    <form method="get">
        <input type="hidden" name="scr" value="nullroutes" />
        <input type="hidden" name="action" value="add" />
        <div class="row g-2 align-items-end">
            <div class="col-sm-auto">
                <label for="rs_nullroute_ip" class="form-label">IP address</label>
                <input type="text" name="ip" id="rs_nullroute_ip" class="form-control"
                    style="min-width:220px" placeholder="e.g. 203.0.113.10" required />
            </div>
            <div class="col-sm-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Add
                </button>
            </div>
        </div>
    </form>
</div>

<?php
if (empty($routes)) {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-slash-circle" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No null routes.</p>
    </div>
<?php
} else {
?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>IP</th>
                    <th>Added</th>
                    <th>Scheduled Removal</th>
                    <th class="text-end">Options</th>
                </tr>
            </thead>
            <tbody>
            <?php
            foreach ((array) $routes as $r) {
                $ip = $r['ipAddress'] ?? ($r['nullRouteIP'] ?? ($r['ip'] ?? ''));
            ?>
                <tr>
                    <td class="rs-mono"><?php echo $this->Html->safe($ip); ?></td>
                    <td><?php echo $this->Html->safe($r['dateAdded'] ?? ($r['createdAt'] ?? '')); ?></td>
                    <td>
                        <?php
                        $sched = $r['scheduledRemove'] ?? '';
                        echo $sched !== ''
                            ? $this->Html->safe($sched)
                            : '<span class="text-muted">-</span>';
                        ?>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-danger rs-confirm"
                            href="?scr=nullroutes&amp;action=remove&amp;ip=<?php echo urlencode($ip); ?>"
                            title="Remove null route"
                            data-confirm-title="Remove null route"
                            data-confirm-button="Remove"
                            data-confirm-message="Remove the null route for <?php echo $this->Html->safe($ip); ?>?">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            <?php
            }
            ?>
            </tbody>
        </table>
    </div>
<?php
}

$base = '?scr=nullroutes&amp;search=' . urlencode($search) . '&amp;page=';

$this->Widget->footer();
?>
<nav aria-label="Null route pages">
    <ul class="pagination pagination-sm mb-0 justify-content-end">
        <li class="page-item<?php echo ($page > 1 ? '' : ' disabled'); ?>">
            <a class="page-link" href="<?php echo ($page > 1 ? $base . ($page - 1) : '#'); ?>">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page <?php echo (int) $page; ?></span></li>
        <li class="page-item<?php echo (empty($routes) ? ' disabled' : ''); ?>">
            <a class="page-link" href="<?php echo (empty($routes) ? '#' : $base . ($page + 1)); ?>">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
<?php
$this->Widget->end();
