<script src="<?php echo $this->Html->safe($this->view_dir . 'js/sweetalert.min.js');?>"></script>
<?php
    if(!empty($vars['errors']))
    {
		?>
		    <section class="error_section">
                <article class="error_box error">
                    <a class="close" href="#">&times;</a>
                    <p><?php echo $vars['errors'][0];?></p>
                </article>
            </section>
		<?php
    }
    $this->Widget->clear();
    $this->Widget->create($this->_("Reliablesite.add_row.ddoshistory", true));
    ?>
    <div class="inner">
        <div class="mb-2">
            <a class="btn btn-primary" href="<?php echo $vars['homeLink'] ?>">Back To Home</a>
        </div>
        <div class="title_row first">
            <h3><?php $this->_("Reliablesite.add_row.ddoshistory");?></h3>
        </div>
       
            <?php
            $this->Form->create();
            ?>
            <div class="mb-2">
                <?php
                
                ?>
                <strong>
                    <?php
                    $this->Form->label("IP Address", "ipAddress", array("class"=> "inline"));
                    ?>
                </strong>
                <?php
                    $this->Form->fieldText("ipAddress", (isset($vars['ipAddress']) ? $vars['ipAddress'] : null), array('id' => "ipAddress"));
                
                $this->Form->fieldSubmit("btnsearch", "Search", array("class"=> "btn btn-primary btn-sm"));
                ?>
            </div>
            <?php

            $this->Form->end();
            ?>
        
        <table class="table">
            <thead>
                <tr class="heading_row">
                    <td>#</td>
                    <td>Target IP</td>
                    <td>Max PPS</td>
                    <td>Max BPS</td>
                    <td>Date Started</td>
                </tr>
            </thead>
            <tbody>
                <?php
                    if(count($vars['ddosAttacks']) > 0){
                        $no = 1;
                        $odd = false;
                        foreach($vars['ddosAttacks'] as $ddosAttack){
                            if($odd == true){
                                $class = "class='odd_row'";
                                $odd = false;
                            }
                            elseif($odd == false){
                                $class = '';
                                $odd = true;
                            }
                            ?>
                            <tr <?php echo $class; ?>>
                                <td><?php echo $no; ?></td>
                                <td><?php echo $ddosAttack['targetIp']; ?></td>
                                <td><?php echo $ddosAttack['maxPps']; ?></td>
                                <td><?php echo $ddosAttack['maxBps'] ?></td>
                                <td><?php echo date("m/d/Y H:i:s a", strtotime($ddosAttack['startTimeStamp'])); ?></td>
                            </tr>
                            <?php
                            $no++;
                        }
                    }
                    else{
                        ?>
                            <tr>
                                <td class="text-center" colspan="5">No Data Found</td>
                            </tr>    
                        <?php    
                    }
                        ?>            
            </tbody>
        </table>
        <div class="pagination">
            <ul>
                <li class="previous"><a href="<?php echo $vars['prevPageLink'] ?>">« Previous Page</a></li>
                <li class=""><a href="javascript:void();">Page <?php echo $vars['page']; ?></a></li>
                <li class="next"><a href="<?php echo $vars['nextPageLink'] ?>">Next Page »</a></li>
            </ul>
        </div>  
    </div>
    <?php
    $this->Widget->end();
    ?>              