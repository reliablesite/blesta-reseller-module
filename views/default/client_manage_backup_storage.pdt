                            </h4>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <label><?php $this->_("Reliablesite.backup_storage.ftp_ip_address"); ?></label>
                            <h4>
                                <?php
                                if($ftp['linkType'] == 'Private'){
                                    echo (isset($backupStorage['ftpPrivateIP']) ? $this->Html->safe($backupStorage['ftpPrivateIP']) : null);
                                }
                                else if($ftp['linkType'] == 'Public'){
                                    echo (isset($backupStorage['ftpPublicIP']) ? $this->Html->safe($backupStorage['ftpPublicIP']) : null); 
                                }
                                ?>
                            </h4>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label><?php $this->_("Reliablesite.backup_storage.ftp_password"); ?></label>
                            <?php
                                $this->Form->fieldText("ftpPassword[]", '', array("class" => "form-control"));
                            ?>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label><?php $this->_("Reliablesite.backup_storage.ftp_enable"); ?></label>
                            <?php
                            $this->Form->fieldSelect("enable[]", ['true' => 'Yes', 'false' => 'No'], (!empty($ftp['enabledSw']) ? 'true' : 'false'), array("class" => "form-control"));
                            ?>
                        </div>
                    </div>

                    <?php
                    $this->Form->fieldHidden("ftpAccountId[]", $ftp['ftpAccountsId']);
                }
                ?>
                <hr>
                <div class="row">
                    <div class="col-md-12 form-group text-center">
                        <?php
                            $this->Form->fieldSubmit("btnUpdateStorage", $this->_('Reliablesite.backup_storage.btn_ftp_update', true), array('id' => "btnUpdateStorage", "class" => "btn btn-primary"));
                        ?>
                        <a href="<?php echo $manageServerLink ?>" class="btn btn-default"><?php $this->_('Reliablesite.back_to_manage_server') ?></a>
                    </div>
                </div>        
                    
                
            </div>    
        </div>
        <?php
        $this->Form->end();
        ?>
        <script type="text/javascript">
            
            jQuery(document).ready(function(){
                
                jQuery("form#frmbackupStorage input#btnUpdateStorage").click(function(e){
                    
                    e.preventDefault();

                    var btn = jQuery(this);
                    var frm = jQuery("form#frmbackupStorage");

                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Updating...');

                    
                    var url = frm.attr('action');
                    var data = frm.serialize();
                    successMessage = "<?php $this->_("Reliablesite.backup_storage.update_success_msg") ?>"

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {
                        if(result.success == 1){
                            swal({
                                title: "Success", 
                                text: successMessage, 
                                type: "success"
                            }).then(function() {
                                location.reload();
                            });
                        }
                        else if(result.errors){
                            swal({
                                title: "Error", 
                                text: result.errors.join("\n"),
                                type: "error"
                            }).then(function() {
                                location.reload();
                            });
                            
                        }
                        else{
                            alert("Something went wrong");
                            location.reload();
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                    });
                });
            });
        </script>
        <?php            
    
}
?>            