<?php
$this->Widget->clear();
$this->Widget->create($this->_('Reliablesite.askbrian.box_title', true));
?>
<div class="inner">
    <?php if (empty($has_key)) { ?>
        <div class="alert alert-warning">
            No ReliableSite API key is configured yet. Add your reseller API key in
            <strong>Settings</strong> before using the assistant.
        </div>
    <?php } ?>

    <div class="rs-brian" id="rs-brian">
        <div class="rs-brian-head">
            <div class="rs-brian-avatar"><i class="bi bi-robot"></i></div>
            <div>
                <div class="rs-brian-who">Brian &middot; Sales Engineer</div>
                <div class="rs-brian-sub">AI assistant for ReliableSite reseller sales &amp; product questions</div>
            </div>
            <button type="button" class="btn btn-default btn-sm rs-brian-new" id="rs-brian-new">
                <i class="bi bi-plus-lg"></i> New chat
            </button>
        </div>

        <div class="rs-brian-log" id="rs-brian-log">
            <div class="rs-msg rs-msg-bot">
                <div class="rs-ava"><i class="bi bi-robot"></i></div>
                <div class="rs-bub">
                    <p>Hi! I'm Brian, your ReliableSite sales engineer. Ask me about server
                    recommendations, specs, pricing, DDoS protection, or anything else to help
                    close a sale.</p>
                    <div class="rs-suggests">
                        <button type="button" data-q="What server do you recommend for a Minecraft server with 200 players?">Minecraft server sizing</button>
                        <button type="button" data-q="What DDoS protection options are available?">DDoS protection</button>
                        <button type="button" data-q="What are your most popular dedicated server plans?">Popular plans</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="rs-brian-foot">
            <form class="rs-brian-form" id="rs-brian-form" autocomplete="off">
                <textarea class="rs-brian-input" id="rs-brian-input" rows="1"
                    placeholder="Ask Brian anything&hellip;" maxlength="2000"<?php echo empty($has_key) ? ' disabled' : ''; ?>></textarea>
                <button type="submit" class="btn btn-primary rs-brian-send" id="rs-brian-send"<?php echo empty($has_key) ? ' disabled' : ''; ?>>
                    <i class="bi bi-send"></i>
                </button>
            </form>
            <div class="rs-brian-hint">Enter to send &middot; Shift+Enter for a new line</div>
        </div>
    </div>
</div>
<script>
(function () {
    var AJAX_URL = <?php echo json_encode($ajax_url); ?>;
    var BASE_SESSION = <?php echo json_encode($session_id); ?>;
    var ASSIGN_KEY = 'rs_brian_assignment_id';

    var log = document.getElementById('rs-brian-log');
    var form = document.getElementById('rs-brian-form');
    var input = document.getElementById('rs-brian-input');
    var sendBtn = document.getElementById('rs-brian-send');
    var newBtn = document.getElementById('rs-brian-new');
    if (!log || !form) { return; }

    var sessionId = BASE_SESSION;
    var busy = false;

    function getAssignmentId() {
        try { return window.localStorage.getItem(ASSIGN_KEY) || ''; } catch (e) { return ''; }
    }
    function setAssignmentId(id) {
        if (!id) { return; }
        try { window.localStorage.setItem(ASSIGN_KEY, id); } catch (e) {}
    }

    function escapeHtml(s) {
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // Minimal, safe Markdown-lite renderer (input is HTML-escaped first).
    function renderMarkdown(text) {
        var safe = escapeHtml(text);
        // Links [label](http...url) - only http/https are allowed.
        safe = safe.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, function (m, label, url) {
            return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + label + '</a>';
        });
        // Bare http(s) URLs not already inside an anchor.
        safe = safe.replace(/(^|[\s(])((https?:\/\/)[^\s<]+)/g, function (m, pre, url) {
            return pre + '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
        });
        safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');

        // Turn lines into paragraphs / bullet lists.
        var lines = safe.split(/\n/);
        var html = '', inList = false;
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            var bullet = line.match(/^[-*]\s+(.*)$/);
            if (bullet) {
                if (!inList) { html += '<ul>'; inList = true; }
                html += '<li>' + bullet[1] + '</li>';
            } else {
                if (inList) { html += '</ul>'; inList = false; }
                if (line !== '') { html += '<p>' + line + '</p>'; }
            }
        }
        if (inList) { html += '</ul>'; }
        return html || '<p></p>';
    }

    function addMessage(role, html) {
        var wrap = document.createElement('div');
        wrap.className = 'rs-msg ' + (role === 'user' ? 'rs-msg-user' : 'rs-msg-bot');
        var ava = document.createElement('div');
        ava.className = 'rs-ava';
        ava.innerHTML = role === 'user' ? '<i class="bi bi-person"></i>' : '<i class="bi bi-robot"></i>';
        var bub = document.createElement('div');
        bub.className = 'rs-bub';
        bub.innerHTML = html;
        wrap.appendChild(ava);
        wrap.appendChild(bub);
        log.appendChild(wrap);
        log.scrollTop = log.scrollHeight;
        return bub;
    }

    function showTyping() {
        var bub = addMessage('bot', '<div class="rs-typing"><span></span><span></span><span></span></div>');
        return bub.parentNode;
    }

    function setBusy(state) {
        busy = state;
        if (sendBtn) { sendBtn.disabled = state; }
        input.disabled = state;
        if (!state) { input.focus(); }
    }

    function send(text) {
        text = (text || '').trim();
        if (!text || busy) { return; }

        addMessage('user', '<p>' + escapeHtml(text).replace(/\n/g, '<br>') + '</p>');
        input.value = '';
        autosize();
        setBusy(true);
        var typing = showTyping();

        var url = AJAX_URL
            + '&message=' + encodeURIComponent(text)
            + '&sessionId=' + encodeURIComponent(sessionId)
            + '&assignmentId=' + encodeURIComponent(getAssignmentId());

        fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (typing && typing.parentNode) { typing.parentNode.removeChild(typing); }
                if (data && data.success) {
                    if (data.sessionId) { sessionId = data.sessionId; }
                    if (data.assignmentId) { setAssignmentId(data.assignmentId); }
                    addMessage('bot', renderMarkdown(data.response || ''));
                } else {
                    var msg = (data && data.error) ? data.error : 'Something went wrong. Please try again.';
                    addMessage('bot', '<p class="rs-error">' + escapeHtml(msg) + '</p>');
                }
            })
            .catch(function () {
                if (typing && typing.parentNode) { typing.parentNode.removeChild(typing); }
                addMessage('bot', '<p class="rs-error">Could not reach the assistant. Please try again.</p>');
            })
            .then(function () { setBusy(false); });
    }

    function autosize() {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 140) + 'px';
    }

    form.addEventListener('submit', function (e) { e.preventDefault(); send(input.value); });
    input.addEventListener('input', autosize);
    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(input.value); }
    });

    log.addEventListener('click', function (e) {
        var t = e.target;
        if (t && t.tagName === 'BUTTON' && t.getAttribute('data-q')) {
            send(t.getAttribute('data-q'));
        }
    });

    if (newBtn) {
        newBtn.addEventListener('click', function () {
            // Start a fresh conversation while preserving the source-identifying prefix.
            sessionId = BASE_SESSION + '-' + Date.now();
            var greeting = log.querySelector('.rs-msg-bot');
            log.innerHTML = '';
            if (greeting) { log.appendChild(greeting); }
            input.focus();
        });
    }
})();
</script>
<?php
$this->Widget->end();
