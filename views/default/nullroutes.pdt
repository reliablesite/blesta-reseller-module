    <script type="text/javascript">
        function removeNullRoute(btn, ip){
            swal({
                    title:'Are you sure?',
                    text:"Are you sure you want to remove this null route?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
            })
            .then((value) => {
                if (value) {
                    url = "<?php echo $vars['removeNullRouteLink'] ?>";
                    var btn = jQuery(btn);

                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Removing...');

                    var _csrf_token =  jQuery("form#frmAddNullRoute input[name='_csrf_token']").val();

                    $.ajax({
                        url : url,
                        method : "post",
                        data : {ip : ip, _csrf_token : _csrf_token}
                    }).done(function (result) {
                        if(result.success == 1){

                            swal({
                                    title: "Success", 
                                    text: "Null Route removed successfully!",
                                    type: "success"
                                })
                                .then((value) => {
                                    location.reload();
                                });
                        }
                        else if(result.errors){
                            swal(
                                'Error',
                                result.errors.join("\n"),
                                'error'
                            );
                        }
                        else{
                            alert("Something went wrong");
                            location.reload();
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                    });
                }
            });
        }

        jQuery(document).ready(function(){
            jQuery("form#frmAddNullRoute").submit(function(e){
                e.preventDefault();

                var btn = jQuery("form#frmAddNullRoute input#btnAddNullRoute");

                btn.attr('disabled',true);
                var oldBtnHtml = btn.val();

                btn.val('Adding...');


                var url = jQuery(this).attr('action');
                var data = jQuery(this).serialize();

                $.ajax({
                    url : url,
                    method : "post",
                    data : data
                }).done(function (result) {
                    if(result.success == 1){

                        swal({
                            title: "Success", 
                            text: "Successfully null routed!", 
                            type: "success"
                        }).then(function(){
                            location.reload();
                        });
                        
                    }
                    else if(result.errors){
                        swal(
                            'Error',
                            result.errors.join("\n"),
                            'error'
                        );
                            
                    }
                    else{
                        alert("Something went wrong");
                        location.reload();
                    }

                    btn.val(oldBtnHtml);
                    btn.attr('disabled',false);

                });
            });
        });
    </script>                