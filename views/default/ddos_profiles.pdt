<?php
foreach ((array) $errors as $e) {
    echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
}

$this->Widget->clear();
if (!empty($section_tabs)) {
    $this->Widget->setTabs($section_tabs);
    $this->Widget->setNavStyle('nav-tabs-custom');
}
$this->Widget->setBodyWrapper(false);
$this->Widget->create('DDoS Profiles', ['id' => 'rs_ddos_profiles']);

// The overlap between this screen and the per-server DDoS tab is the most
// confusable part of the module, so say which is which up front.
?>
<div class="card-body border-bottom py-2 small text-muted">
    <i class="bi bi-info-circle me-1"></i>
    Profiles available across your account. To protect a specific IP, open the
    server under <strong>Provisioning &rsaquo; Servers</strong> and use its
    <strong>DDoS</strong> tab.
</div>
<?php
if (empty($profiles)) {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-shield-check" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3 mb-0">No DDoS profiles available.</p>
    </div>
<?php
} else {
?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Profile</th>
                    <th>Datacenter</th>
                    <th>Protected IPs</th>
                </tr>
            </thead>
            <tbody>
            <?php
            foreach ((array) $profiles as $profile) {
                $name = '';
                if (isset($profile['profile'])) {
                    $name = is_array($profile['profile'])
                        ? ($profile['profile']['name'] ?? json_encode($profile['profile']))
                        : $profile['profile'];
                } elseif (isset($profile['name'])) {
                    $name = $profile['name'];
                }
                $ips = isset($profile['ips']) && is_array($profile['ips']) ? $profile['ips'] : [];
            ?>
                <tr>
                    <td><?php echo $this->Html->safe($name); ?></td>
                    <td><?php echo $this->Html->safe($profile['dataCenterName'] ?? ''); ?></td>
                    <td><span class="badge text-bg-secondary"><?php echo (int) count($ips); ?></span></td>
                </tr>
            <?php
            }
            ?>
            </tbody>
        </table>
    </div>
<?php
}

$this->Widget->end();
