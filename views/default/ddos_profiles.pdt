<?php
$this->Widget->clear();
$this->Widget->create('DDoS Profiles');
?>
<div class="inner">
    <?php
    foreach ((array) $errors as $e) {
        echo '<div class="alert alert-danger">' . $this->Html->safe(is_scalar($e) ? $e : json_encode($e)) . '</div>';
    }
    ?>
    <table class="table">
        <tr class="heading_row">
            <td>Profile</td>
            <td>Datacenter</td>
            <td>Protected IPs</td>
        </tr>
        <?php
        foreach ((array) $profiles as $profile) {
            $name = '';
            if (isset($profile['profile'])) {
                $name = is_array($profile['profile'])
                    ? (isset($profile['profile']['name']) ? $profile['profile']['name'] : json_encode($profile['profile']))
                    : $profile['profile'];
            } elseif (isset($profile['name'])) {
                $name = $profile['name'];
            }
            $ips = isset($profile['ips']) && is_array($profile['ips']) ? $profile['ips'] : [];
            ?>
            <tr>
                <td><?php echo $this->Html->safe($name); ?></td>
                <td><?php echo $this->Html->safe(isset($profile['dataCenterName']) ? $profile['dataCenterName'] : ''); ?></td>
                <td><?php echo (int) count($ips); ?></td>
            </tr>
            <?php
        }
        if (empty($profiles)) {
            echo '<tr><td colspan="3">No DDoS profiles available.</td></tr>';
        }
        ?>
    </table>
</div>
<?php
$this->Widget->end();
