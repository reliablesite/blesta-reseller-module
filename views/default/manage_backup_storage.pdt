<script src="<?php echo $this->Html->safe($this->view_dir . 'js/sweetalert.min.js');?>"></script>
<link rel="stylesheet" type="text/css" href="<?php echo $this->Html->safe($this->view_dir . '/css/style.css');?>">
<?php
$this->Widget->clear();
$this->Widget->create('Manage Backup Storage');
?>
<div class="inner">
    <div class="mb-2">
        <a class="btn btn-primary" href="<?php echo $homeLink ?>">Back To Home</a>
        <a class="btn btn-primary" href="<?php echo $manageServerLink ?>">Back To Manage</a>
    </div>
    <?php
    if(!empty($error)){

        ?>
            <section class="error_section">
                <article class="error_box error">
                    <a class="close" href="#">&times;</a>
                    <?php echo $error;?>
                </article>
            </section>
        
        <?php
        } 
    else{
        ?>
        <div class="title_row first">
            <h3><?php $this->_("Reliablesite.tab_ManageBackupStorage"); ?></h3>
        </div>
        <?php
        $this->Form->create($updateBackupStorageLink, array('id'=> 'frmbackupStorage'));
        $this->Form->fieldHidden("serverId", $rsServerId);
        ?>
        <div class="pad">
            <ul>
                
               
                <li>
                    <label><?php $this->_("Reliablesite.client_server_details.server_name"); ?></label>
                    <strong>
                        <?php echo (isset($backupStorage['serverLabel']) ? $this->Html->safe($backupStorage['serverLabel']) : null); ?>
                    </strong>
                </li>
                <li>
                    <label><?php $this->_("Reliablesite.backup_storage.backup_space_name"); ?></label>
                    <strong>
                        <?php echo (isset($backupStorage['backupSpaceName']) ? $this->Html->safe($backupStorage['backupSpaceName']) : null); ?>
                    </strong>
                </li>
                <li>
                    <label><?php $this->_("Reliablesite.backup_storage.total_size"); ?></label>
                    <strong>
                        <?php echo (isset($backupStorage['totalSize']) ? $this->Html->safe($backupStorage['totalSize']) : null); ?>
                    </strong>
                </li>
                <li>
                    <label><?php $this->_("Reliablesite.backup_storage.size_remaining"); ?></label>
                    <strong>
                        <?php echo (isset($backupStorage['sizeRemaining']) ? $this->Html->safe($backupStorage['sizeRemaining']) : null); ?>
                    </strong>
                </li>
                <?php
                foreach($backupStorage['ftp'] as $ftp){                
                    if($ftp['linkType'] == 'Private'){
                        ?>
                        <li>
                            <h4><?php $this->_("Reliablesite.backup_storage.private_account"); ?></h4>
                        </li>
                        <?php
                    }
                    else if($ftp['linkType'] == 'Public'){
                        ?>
                        <li>
                            <h4><?php $this->_("Reliablesite.backup_storage.public_account"); ?></h4>
                        </li>
                        <?php
                    }
                    ?>
                    <li>
                        <label><?php $this->_("Reliablesite.backup_storage.ftp_name"); ?></label>
                        <strong>
                            <?php echo (isset($ftp['userName']) ? $this->Html->safe($ftp['userName']) : null); ?>
                        </strong>
                    </li>
                    
                    <li>
                       
                        <label><?php $this->_("Reliablesite.backup_storage.ftp_ip_address"); ?></label>
                        <strong>
                            <?php
                            if($ftp['linkType'] == 'Private'){
                                echo (isset($backupStorage['ftpPrivateIP']) ? $this->Html->safe($backupStorage['ftpPrivateIP']) : null);
                            }
                            else if($ftp['linkType'] == 'Public'){
                                echo (isset($backupStorage['ftpPublicIP']) ? $this->Html->safe($backupStorage['ftpPublicIP']) : null); 
                            }
                            ?>
                        </strong>
                        
                    </li>
                    <li>
                        <label><?php $this->_("Reliablesite.backup_storage.ftp_password"); ?></label>
                        <?php
                            $this->Form->fieldText("ftpPassword[]", '', array("class" => "xlarge"));
                        ?>
                    </li>
                    <li>
                        <label><?php $this->_("Reliablesite.backup_storage.ftp_enable"); ?></label>
                        <?php
                        $this->Form->fieldSelect("enable[]", ['true' => 'Yes', 'false' => 'No'], (!empty($ftp['enabledSw']) ? 'true' : 'false'), array("class" => "xlarge"));
                        ?>
                    </li>
                    <?php
                    $this->Form->fieldHidden("ftpAccountId[]", $ftp['ftpAccountsId']);
                }
                ?>
                
                <li class="text-center">
                   
                    <?php
                        $this->Form->fieldSubmit("btnUpdateStorage", $this->_('Reliablesite.backup_storage.btn_ftp_update', true), array('id' => "btnUpdateStorage", "class" => "btn btn-primary"));
                    ?>
                </li> 
            </ul>    
        </div>
        <?php
        $this->Form->end();
        ?>
        <script type="text/javascript">
            
            jQuery(document).ready(function(){
                
                jQuery("form#frmbackupStorage input#btnUpdateStorage").click(function(e){
                    
                    e.preventDefault();

                    var btn = jQuery(this);
                    var frm = jQuery("form#frmbackupStorage");

                    btn.attr('disabled',true);
                    var oldBtnHtml = btn.val();

                    btn.val('Updating...');

                    
                    var url = frm.attr('action');
                    var data = frm.serialize();
                    successMessage = "<?php $this->_("Reliablesite.backup_storage.update_success_msg") ?>"

                    $.ajax({
                        url : url,
                        method : "post",
                        data : data
                    }).done(function (result) {
                        if(result.success == 1){
                            swal({
                                title: "Success", 
                                text: successMessage, 
                                type: "success"
                            }).then(function() {
                                location.reload();
                            });
                        }
                        else if(result.errors){
                            swal({
                                title: "Error", 
                                text: result.errors.join("\n"),
                                type: "error"
                            }).then(function() {
                                location.reload();
                            });
                            
                        }
                        else{
                            alert("Something went wrong");
                            location.reload();
                        }

                        btn.val(oldBtnHtml);
                        btn.attr('disabled',false);

                    });
                });
            });
        </script>

     
    <?php            
    
    }
?>
</div>
<?php
$this->Widget->end();
?>            