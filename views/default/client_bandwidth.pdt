<?php
$nav = ['overview' => 'Overview', 'os' => 'Reinstall OS', 'kvm' => 'KVM', 'bandwidth' => 'Bandwidth', 'backups' => 'Backups', 'rdns' => 'Reverse DNS', 'mac' => 'MAC', 'ddos' => 'DDoS'];
?>
<ul class="nav nav-pills mb-3">
    <?php foreach ($nav as $key => $label) {
        $active = ($page === $key) ? ' active' : ''; ?>
        <li class="nav-item"><a class="nav-link<?php echo $active; ?>" href="?p=<?php echo $key; ?>"><?php echo $label; ?></a></li>
    <?php } ?>
</ul>
<?php
if (!empty($error)) {
    echo '<div class="alert alert-danger">' . $this->Html->safe($error) . '</div>';
}
$periods = ['Hour', 'Day', 'Week', 'Month', 'Year'];
$hasData = !empty($bandwidth_series['labels']);
?>
<div class="card mb-3">
    <div class="card-header"><strong>Bandwidth</strong></div>
    <div class="card-body">
        <div class="rs-actions mb-2">
            <?php foreach ($periods as $p) { ?>
                <?php $this->Form->create(); ?>
                <input type="hidden" name="period" value="<?php echo $p; ?>" />
                <button type="submit" class="btn btn-sm <?php echo ($period === $p ? 'btn-primary' : 'btn-default'); ?>"><?php echo $p; ?></button>
                <?php $this->Form->end(); ?>
            <?php } ?>
        </div>
        <?php if (!$hasData) { ?>
            <p class="text-muted">No bandwidth data available for this period.</p>
        <?php } else { ?>
            <div class="rs-chart" style="position:relative;height:320px;width:100%;">
                <canvas id="rs-bw-chart"></canvas>
            </div>
            <script type="text/javascript" src="<?php echo $this->Html->safe($this->view_dir . 'js/chart.umd.min.js'); ?>"></script>
            <script type="text/javascript" src="<?php echo $this->Html->safe($this->view_dir . 'js/rs-charts.js'); ?>"></script>
            <script type="text/javascript">
                window.rsBandwidthChart(
                    'rs-bw-chart',
                    <?php echo json_encode($bandwidth_series); ?>,
                    'client'
                );
            </script>
        <?php } ?>
    </div>
</div>
