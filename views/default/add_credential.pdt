						?>
						<span class="input_span block">
							<?php
							$this->Form->fieldText("api_key", (isset($vars->api_key) ? $vars->api_key : null), array('id' => "api_key", "class" => "xlarge"));
							?>
							 The API key is available within the dedicated server management interface.
						</span>
					
					</li>
					<li>
						<?php
